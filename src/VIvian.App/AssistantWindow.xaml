<Window x:Class="VIvian.App.AssistantWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
xmlns:local="clr-namespace:VIvian.App" xmlns:gif="https://github.com/XamlAnimatedGif/XamlAnimatedGif"
Title="AI 智能助手" Width="440" Height="680" MinWidth="360" MinHeight="460" WindowStyle="None" AllowsTransparency="True" Background="Transparent"
ResizeMode="CanResizeWithGrip" ShowInTaskbar="False" FontFamily="Microsoft YaHei UI" FontSize="14" Foreground="{StaticResource Text}">
<Window.Resources>
<Style TargetType="TextBlock"><Setter Property="Foreground" Value="{StaticResource Text}"/><Setter Property="TextWrapping" Value="Wrap"/><Setter Property="LineHeight" Value="22"/></Style>
<!-- Avatar: GIF animates, other images are static, no file shows the vector guide. -->
<DataTemplate x:Key="AvatarArt"><Grid>
<Image gif:AnimationBehavior.SourceUri="{Binding Uri}" Visibility="{Binding GifVisibility}" Stretch="UniformToFill"/>
<Image Source="{Binding Uri}" Visibility="{Binding StaticVisibility}" Stretch="UniformToFill"/>
<local:Mascot Visibility="{Binding FallbackVisibility}"/></Grid></DataTemplate>
</Window.Resources>
<Border Background="{StaticResource Surface}" BorderBrush="{StaticResource Gold}" BorderThickness="1.5" CornerRadius="22" Margin="8">
<Border.Effect><DropShadowEffect BlurRadius="24" ShadowDepth="4" Opacity="0.35" Color="#1A2B6B"/></Border.Effect>
<Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>

<!-- Header: drag to move -->
<Border Background="{StaticResource NavyRibbon}" CornerRadius="20,20,0,0" Padding="16,12" MouseLeftButtonDown="DragHeader" Cursor="SizeAll">
<Grid><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
<Border Width="46" Height="46" CornerRadius="23" Background="#E9EFFF" BorderBrush="{StaticResource Gold}" BorderThickness="1.5" ClipToBounds="True">
<ContentPresenter Content="{Binding Avatar}" ContentTemplate="{StaticResource AvatarArt}" Margin="2"/></Border>
<StackPanel Grid.Column="1" Margin="12,0,8,0" VerticalAlignment="Center">
<TextBlock Text="{Binding Name, StringFormat=AI 智能助手 · {0}}" Foreground="White" FontSize="16" FontWeight="Bold" TextWrapping="NoWrap"/>
<TextBlock Text="{Binding StatusLine}" Foreground="{StaticResource OnNavy}" FontSize="12" TextWrapping="NoWrap"/></StackPanel>
<StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
<Button Content="⚙" Command="{Binding ToggleSettingsCommand}" ToolTip="AI 接口设置" Background="#2E4AA8" Foreground="White" BorderBrush="#5A75C8" Padding="10,5" Margin="0,0,6,0" AutomationProperties.Name="AI 接口设置"/>
<Button Content="✕" Click="CloseWindow" ToolTip="收起（对话会保留）" Background="#2E4AA8" Foreground="White" BorderBrush="#5A75C8" Padding="10,5" Margin="0" AutomationProperties.Name="收起助手"/></StackPanel></Grid></Border>

<!-- Endpoint settings -->
<Border Grid.Row="1" Visibility="{Binding SettingsVisibility}" Background="{StaticResource Tile}" BorderBrush="{StaticResource Line}" BorderThickness="0,0,0,1" Padding="16,12"><StackPanel>
<TextBlock Text="AI 接口（兼容 OpenAI 的 chat/completions，需支持工具调用）" FontWeight="SemiBold" FontSize="13"/>
<TextBlock Text="接口地址，例如 https://api.deepseek.com/v1" Foreground="{StaticResource Muted}" FontSize="12" Margin="0,8,0,2"/>
<TextBox Text="{Binding BaseUrl, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="接口地址"/>
<TextBlock Text="模型名" Foreground="{StaticResource Muted}" FontSize="12" Margin="0,8,0,2"/>
<TextBox Text="{Binding Model, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="模型名"/>
<TextBlock Text="密钥（留空表示不修改已保存的密钥）" Foreground="{StaticResource Muted}" FontSize="12" Margin="0,8,0,2"/>
<PasswordBox x:Name="KeyBox" PasswordChanged="KeyChanged" Padding="10,7" Background="White" Foreground="{StaticResource Text}" BorderBrush="{StaticResource Line}" AutomationProperties.Name="密钥"/>
<WrapPanel Margin="0,10,0,0">
<Button Style="{StaticResource Primary}" Content="保存" Command="{Binding SaveSettingsCommand}"/>
<Button Content="测试连接" Command="{Binding TestConnectionCommand}" Margin="6,0,0,0"/>
</WrapPanel>
<TextBlock Text="{Binding SettingsStatus}" Foreground="{StaticResource Muted}" FontSize="12" Margin="0,8,0,0"/></StackPanel></Border>

<!-- Conversation -->
<ScrollViewer x:Name="ChatScroll" Grid.Row="2" VerticalScrollBarVisibility="Auto" Padding="14,12">
<ItemsControl ItemsSource="{Binding Messages}"><ItemsControl.ItemTemplate><DataTemplate>
<Grid Margin="0,0,0,12" HorizontalAlignment="{Binding Align}"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
<Border Width="34" Height="34" CornerRadius="17" Background="#E9EFFF" BorderBrush="{StaticResource Gold}" BorderThickness="1" ClipToBounds="True" VerticalAlignment="Top" Margin="0,0,8,0" Visibility="{Binding AvatarVisibility}">
<ContentPresenter Content="{Binding DataContext.Avatar, RelativeSource={RelativeSource AncestorType=Window}}" ContentTemplate="{StaticResource AvatarArt}" Margin="1"/></Border>
<Border Grid.Column="1" CornerRadius="16" Padding="14,10" MaxWidth="320" BorderThickness="1">
<Border.Style><Style TargetType="Border"><Setter Property="Background" Value="{StaticResource Bubble}"/><Setter Property="BorderBrush" Value="{StaticResource Line}"/>
<Style.Triggers><DataTrigger Binding="{Binding FromUser}" Value="True"><Setter Property="Background" Value="{StaticResource UserBubble}"/><Setter Property="BorderBrush" Value="{StaticResource UserBubble}"/></DataTrigger></Style.Triggers></Style></Border.Style>
<StackPanel>
<TextBlock Text="{Binding Text}"><TextBlock.Style><Style TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}"><Style.Triggers>
<DataTrigger Binding="{Binding FromUser}" Value="True"><Setter Property="Foreground" Value="White"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock>
<ItemsControl ItemsSource="{Binding Proposals}"><ItemsControl.ItemTemplate><DataTemplate>
<Border Background="{StaticResource Tile}" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="12" Padding="12,10" Margin="0,10,0,0"><StackPanel>
<TextBlock Text="修改预览" FontWeight="Bold" FontSize="13"/>
<TextBlock Text="{Binding Lines}" FontSize="13" Margin="0,4,0,0"/>
<TextBlock Text="{Binding State}" Foreground="{StaticResource Muted}" FontSize="12" Margin="0,6,0,0"/>
<Button Style="{StaticResource Primary}" Content="确认修改" Command="{Binding ConfirmCommand}" IsEnabled="{Binding CanConfirm}" HorizontalAlignment="Left" Margin="0,8,0,0" Padding="16,7"/>
</StackPanel></Border></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
</StackPanel></Border></Grid></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></ScrollViewer>

<!-- Quick commands -->
<StackPanel Grid.Row="3" Margin="14,4,14,6"><TextBlock Text="快捷指令" FontWeight="SemiBold" FontSize="13" Margin="2,0,0,6"/>
<ItemsControl ItemsSource="{Binding QuickCommands}"><ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
<ItemsControl.ItemTemplate><DataTemplate><Button Content="{Binding}" Command="{Binding DataContext.QuickCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}" FontSize="12" Padding="12,5" Margin="0,0,6,6" Background="White"/></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></StackPanel>

<!-- Input -->
<Border Grid.Row="4" Background="White" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="16" Margin="14,0,14,14" Padding="6">
<DockPanel><Button DockPanel.Dock="Right" Style="{StaticResource Primary}" Content="➤" Command="{Binding SendCommand}" Padding="14,8" Margin="6,0,0,0" ToolTip="发送（Enter）" AutomationProperties.Name="发送"/>
<Button DockPanel.Dock="Right" Content="取消请求" IsEnabled="{Binding IsBusy}" Command="{Binding CancelRequestCommand}" Margin="6,0,0,0"/>
<TextBox x:Name="InputBox" Text="{Binding Input, UpdateSourceTrigger=PropertyChanged}" BorderThickness="0" Background="White" AutomationProperties.Name="输入你的问题">
<TextBox.InputBindings><KeyBinding Key="Enter" Command="{Binding SendCommand}"/></TextBox.InputBindings></TextBox></DockPanel></Border>
</Grid></Border></Window>
