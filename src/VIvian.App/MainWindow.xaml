<Button Content="开始模拟队列" Command="{Binding StartCommand}" IsEnabled="{Binding IsIdle}" Margin="0,0,0,8"/>
<Button Style="{StaticResource DangerButton}" Content="紧急停止" Command="{Binding StopCommand}" IsEnabled="{Binding IsRunning}" Margin="0,0,0,8" AutomationProperties.HelpText="立即停止，不倒计时"/>
<TextBlock Text="{Binding Current}" Style="{StaticResource Small}" AutomationProperties.LiveSetting="Polite"/></StackPanel></Grid></Expander>
</Grid></TabItem>

<!-- ============ 引擎与环境 ============ -->
<TabItem Header="引擎与环境" Tag="&#xE950;"><ScrollViewer Style="{StaticResource Page}"><StackPanel IsEnabled="{Binding IsIdle}" MaxWidth="980" HorizontalAlignment="Left">
<StackPanel Orientation="Horizontal"><TextBlock Text="引擎与环境" Style="{StaticResource H1}"/><TextBlock Text="エンジン" Style="{StaticResource Kana}"/></StackPanel>
<TextBlock Text="VIvian 启动时会自动找到三款引擎并核对固定版本。只有自动发现失败时才需要手动填写目录。检查全程只读，不会运行任何程序。" Style="{StaticResource Lead}"/>
<ItemsControl ItemsSource="{Binding Engines}"><ItemsControl.ItemTemplate><DataTemplate><Border Style="{StaticResource Panel}"><StackPanel>
<Grid><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
<Ellipse Width="10" Height="10" Fill="{Binding Accent}" VerticalAlignment="Center" Margin="0,0,12,0"/>
<TextBlock Grid.Column="1" Text="{Binding Name}" FontSize="18" FontWeight="SemiBold"/><TextBlock Grid.Column="2" Text="{Binding Compatibility}" Foreground="{Binding StateBrush}" FontWeight="SemiBold"/></Grid>
<TextBlock Text="{Binding PinnedVersion}" Style="{StaticResource Small}" Margin="0,4,0,12"/>
<DockPanel><Button DockPanel.Dock="Right" Content="浏览…" Click="BrowseEngineFolder" Tag="{Binding}" Margin="8,0,0,0"/>
<TextBox Text="{Binding InstallPath, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="{Binding Name}" ToolTip="引擎安装目录"/></DockPanel>
<TextBlock Text="{Binding DetectedVersion}" Style="{StaticResource Small}" Margin="0,10,0,0"/>
<TextBlock Text="{Binding PendingWarning}" Foreground="{StaticResource Warn}" FontSize="13" Margin="0,4,0,0"><TextBlock.Style><Style TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}"><Style.Triggers><Trigger Property="Text" Value=""><Setter Property="Visibility" Value="Collapsed"/></Trigger></Style.Triggers></Style></TextBlock.Style></TextBlock>
<Expander><Expander.Header><TextBlock Text="检查详情" Foreground="{StaticResource Muted}"/></Expander.Header><ItemsControl ItemsSource="{Binding Checks}" Margin="0,8,0,0"><ItemsControl.ItemTemplate><DataTemplate>
<Grid Margin="0,0,0,8"><Grid.ColumnDefinitions><ColumnDefinition Width="90"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
<TextBlock Text="{Binding State}" Foreground="{Binding Brush}" FontWeight="SemiBold"/>
<StackPanel Grid.Column="1"><TextBlock Text="{Binding Title}" FontWeight="SemiBold"/><TextBlock Text="{Binding Message}" Style="{StaticResource Small}"/><TextBlock Text="{Binding Action}" Foreground="{StaticResource Sakura}" FontSize="13"/></StackPanel>
</Grid></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></Expander>
<Expander><Expander.Header><TextBlock Text="能力与证据" Foreground="{StaticResource Muted}"/></Expander.Header><ItemsControl ItemsSource="{Binding Capabilities}" Margin="0,8,0,0"><ItemsControl.ItemTemplate><DataTemplate>
<Grid Margin="0,0,0,8"><Grid.ColumnDefinitions><ColumnDefinition Width="220"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
<StackPanel><TextBlock Text="{Binding Title}" FontWeight="SemiBold"/><TextBlock Text="{Binding Status}" Foreground="{Binding Brush}" FontSize="13"/></StackPanel>
<TextBlock Grid.Column="1" Text="{Binding Note}" Style="{StaticResource Small}" Margin="10,0,0,0"/>
</Grid></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></Expander>
</StackPanel></Border></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
<WrapPanel Margin="0,4,0,14"><Button Content="自动填入已发现目录" Command="{Binding AutoDiscoverCommand}" Margin="0,0,10,8"/><Button Style="{StaticResource Primary}" Content="保存路径并检查" Command="{Binding SaveCommand}" Margin="0,0,10,8"/><Button Content="重新检查" Command="{Binding CheckEnginesCommand}" Margin="0,0,10,8"/><Button Content="放弃未保存的修改" Command="{Binding ReloadCommand}" Margin="0,0,10,8"/></WrapPanel>
<Border Style="{StaticResource Panel}"><StackPanel>
<TextBlock Text="星铁官方发行包" Style="{StaticResource H2}"/>
<TextBlock Text="VIvian 用官方 March7thAssistant_full.zip（v2026.10.31）的 SHA-256 核对安装目录里的 m7a.exe。不解压，不运行；位置会被记住，每次启动自动核对。" Style="{StaticResource Small}" Margin="0,0,0,10"/>
<DockPanel><Button DockPanel.Dock="Right" Content="浏览…" Click="BrowseReleaseArchive" Margin="8,0,0,0"/><TextBox Text="{Binding ReleaseArchivePath, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="官方发行包路径" ToolTip="官方发行包文件路径"/></DockPanel>
<WrapPanel Margin="0,10,0,0"><Button Content="核对发行包" Command="{Binding VerifyReleaseCommand}"/></WrapPanel>
<TextBlock Text="{Binding ReleaseStatus}" Style="{StaticResource Small}" Margin="0,8,0,0"/>
</StackPanel></Border>
</StackPanel></ScrollViewer></TabItem>

<!-- ============ 资源与更新 ============ -->
<TabItem Header="资源与更新" Tag="&#xE8B7;"><ScrollViewer Style="{StaticResource Page}"><StackPanel MaxWidth="900" HorizontalAlignment="Left">
<StackPanel Orientation="Horizontal"><TextBlock Text="资源与更新" Style="{StaticResource H1}"/><TextBlock Text="リソース" Style="{StaticResource Kana}"/></StackPanel>
<TextBlock Text="界面角色、头像和游戏横幅来自你自己的素材文件夹；引擎版本固定为已核对的版本。" Style="{StaticResource Lead}"/>
<Border Style="{StaticResource Panel}"><StackPanel>
<TextBlock Text="界面素材" Style="{StaticResource H2}"/>
<TextBlock Text="{Binding Theme.Folder, StringFormat=素材文件夹：{0}}" Style="{StaticResource Small}"/>
<TextBlock Text="放入以下文件后重新打开 VIvian 即可生效（GIF 会自动播放）：" Margin="0,10,0,4"/>
<TextBlock Text="character.gif / .png：首页左侧的大角色，点击会打开 AI 助手" Style="{StaticResource Small}"/>
<TextBlock Text="assistant.gif / .png：AI 助手头像和提示栏小人（不放则使用 character）" Style="{StaticResource Small}"/>
<TextBlock Text="banner-genshin / banner-starrail / banner-zzz（.png/.jpg）：游戏横幅；background.png：背景" Style="{StaticResource Small}"/>
<TextBlock Text="theme.json：{ &quot;assistantName&quot;: &quot;助手名字&quot;, &quot;title&quot;: &quot;窗口标题&quot; }" Style="{StaticResource Small}"/>
<WrapPanel Margin="0,12,0,0"><Button Content="创建并复制素材文件夹路径" Click="CopyThemeFolder"/></WrapPanel></StackPanel></Border>
<Border Style="{StaticResource Panel}"><StackPanel>
<TextBlock Text="引擎版本" Style="{StaticResource H2}"/>
<ItemsControl ItemsSource="{Binding Engines}"><ItemsControl.ItemTemplate><DataTemplate><Grid Margin="0,0,0,6"><TextBlock Text="{Binding Name}"/><TextBlock Text="{Binding Version}" Style="{StaticResource Small}" HorizontalAlignment="Right"/></Grid></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
<TextBlock Text="引擎更新与回滚尚未开放：换版本前需要重新核对配置格式与任务接口，避免写坏你的设置。" Style="{StaticResource Small}" Margin="0,8,0,0"/></StackPanel></Border>
</StackPanel></ScrollViewer></TabItem>

<!-- ============ 设置中心 ============ -->
<TabItem Header="设置中心" Tag="&#xE713;"><ScrollViewer Style="{StaticResource Page}"><StackPanel IsEnabled="{Binding IsIdle}" MaxWidth="900" HorizontalAlignment="Left">
<StackPanel Orientation="Horizontal"><TextBlock Text="设置中心" Style="{StaticResource H1}"/><TextBlock Text="せってい" Style="{StaticResource Kana}"/></StackPanel>
<TextBlock Text="{Binding VersionText}" Style="{StaticResource Lead}" Margin="0,6,0,2"/>
<TextBlock Text="{Binding DataDirectoryText}" Style="{StaticResource Small}" Margin="0,0,0,20"/>
<Border Style="{StaticResource Panel}"><StackPanel>
<TextBlock Text="偏好" Style="{StaticResource H2}"/>
<DockPanel Margin="0,6,0,12"><TextBlock Text="日志保留天数（3–90）" VerticalAlignment="Center" Margin="0,0,12,0"/><TextBox Text="{Binding LogRetentionDays, UpdateSourceTrigger=PropertyChanged}" Width="80" HorizontalAlignment="Left" AutomationProperties.Name="日志保留天数"/></DockPanel>
<CheckBox IsChecked="{Binding IncludeRunHistory}" Content="诊断包中包含运行记录（只有状态与原因代码）" AutomationProperties.Name="诊断包包含运行记录" Margin="0,0,0,14"/>
<WrapPanel><Button Style="{StaticResource Primary}" Content="保存设置" Command="{Binding SavePreferencesCommand}"/></WrapPanel></StackPanel></Border>
<Border Style="{StaticResource Panel}"><StackPanel>
<TextBlock Text="诊断" Style="{StaticResource H2}"/>
<TextBlock Text="导出本地 ZIP：版本、引擎检查、运行记录与最近日志。用户名、计算机名、口令与令牌已去除；不含数据库、上游配置或账号信息，也不会自动上传。" Style="{StaticResource Small}" Margin="0,0,0,12"/>
<WrapPanel><Button Content="导出诊断包" Command="{Binding ExportDiagnosticsCommand}" Margin="0,0,10,8"/><Button Content="复制导出文件夹路径" Click="CopyExportsPath" Margin="0,0,10,8"/><Button Content="复制日志文件夹路径" Click="CopyLogsPath" Margin="0,0,10,8"/></WrapPanel>
<TextBlock Text="{Binding ExportStatus}" Style="{StaticResource Small}" AutomationProperties.LiveSetting="Polite"/></StackPanel></Border>
<Border Style="{StaticResource Panel}"><StackPanel>
<Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
<TextBlock Text="基础自检记录" Style="{StaticResource H2}"/><Button Grid.Column="1" Content="刷新" Command="{Binding ReloadCommand}" IsEnabled="{Binding IsIdle}" Margin="0"/></Grid>
<TextBlock Text="这里不是游戏任务历史。时间为 UTC。" Style="{StaticResource Small}" Margin="0,0,0,8"/>
<ListView ItemsSource="{Binding History}" MaxHeight="240" Background="{StaticResource Surface}" HorizontalContentAlignment="Stretch" ScrollViewer.HorizontalScrollBarVisibility="Disabled"><ListView.ItemTemplate><DataTemplate><StackPanel Margin="0,6"><TextBlock Text="{Binding StartedAt, StringFormat={}{0:yyyy-MM-dd HH:mm:ss} UTC}" Foreground="{StaticResource Sakura}" FontSize="13"/><TextBlock Text="{Binding Summary}" Style="{StaticResource Small}"/></StackPanel></DataTemplate></ListView.ItemTemplate></ListView>
</StackPanel></Border>
<Border Style="{StaticResource Panel}"><StackPanel>
<TextBlock Text="关于" Style="{StaticResource H2}"/>
<TextBlock Text="VIvian 是三款开源自动化工具的统一控制中心：BetterGI v0.66.0、March7thAssistant v2026.10.31、ZenlessZoneZero-OneDragon v2.6.0。识别、战斗和寻路由它们完成，VIvian 负责配置、编排和结果核验。" Style="{StaticResource Small}"/>
<TextBlock Text="以普通用户权限运行，不会静默提权；引擎只从官方 GitHub Release 获取；不要把引擎放在符号链接或目录联接后面。OneDragon 官方要求安装路径只含英文字母、数字、下划线和连字符。" Style="{StaticResource Small}" Margin="0,8,0,0"/>
<TextBlock Text="本程序与游戏官方无关，不收集游戏密码，不自动上传诊断信息。游戏自动化存在账号处罚风险，VIvian 不承诺零风险，也不会绕过反作弊。" Foreground="{StaticResource Warn}" FontSize="13" Margin="0,8,0,0"/></StackPanel></Border>
</StackPanel></ScrollViewer></TabItem>
</TabControl>

