<Window x:Class="VIvian.App.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:VIvian.App"
Title="VIvian" Width="1240" Height="820" MinWidth="960" MinHeight="600" Background="{StaticResource Ink}" Foreground="{StaticResource Text}" FontFamily="Microsoft YaHei UI" FontSize="14" WindowStartupLocation="CenterScreen" UseLayoutRounding="True" TextOptions.TextFormattingMode="Display">
<Window.Resources>
<!-- Window-level implicit styles stop at template boundaries, so controls keep their own text colours. -->
<Style TargetType="TextBlock"><Setter Property="Foreground" Value="{StaticResource Text}"/><Setter Property="TextWrapping" Value="Wrap"/><Setter Property="LineHeight" Value="22"/></Style>
<Style x:Key="H1" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}"><Setter Property="FontSize" Value="32"/><Setter Property="FontFamily" Value="{StaticResource Round}"/><Setter Property="LineHeight" Value="40"/></Style>
<!-- Small Japanese subtitle next to a page title. -->
<Style x:Key="Kana" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}"><Setter Property="Foreground" Value="{StaticResource Sakura}"/><Setter Property="FontSize" Value="15"/><Setter Property="FontFamily" Value="{StaticResource JapaneseFont}"/><Setter Property="Margin" Value="16,0,0,5"/><Setter Property="VerticalAlignment" Value="Bottom"/></Style>
<Style x:Key="H2" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}"><Setter Property="FontSize" Value="19"/><Setter Property="FontFamily" Value="{StaticResource Round}"/><Setter Property="Margin" Value="0,0,0,6"/></Style>
<Style x:Key="Lead" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}"><Setter Property="Foreground" Value="{StaticResource Muted}"/><Setter Property="Margin" Value="0,6,0,22"/><Setter Property="MaxWidth" Value="760"/><Setter Property="HorizontalAlignment" Value="Left"/></Style>
<Style x:Key="Small" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}"><Setter Property="Foreground" Value="{StaticResource Muted}"/><Setter Property="FontSize" Value="13"/><Setter Property="LineHeight" Value="20"/></Style>
<Style x:Key="Panel" TargetType="Border"><Setter Property="Background" Value="{StaticResource Surface}"/><Setter Property="BorderBrush" Value="{StaticResource Line}"/><Setter Property="BorderThickness" Value="1"/><Setter Property="CornerRadius" Value="20,4,20,4"/><Setter Property="Padding" Value="22"/><Setter Property="Margin" Value="0,0,0,14"/></Style>
<Style x:Key="Notice" TargetType="Border"><Setter Property="Background" Value="{StaticResource WarnBack}"/><Setter Property="CornerRadius" Value="10"/><Setter Property="Padding" Value="16,12"/><Setter Property="Margin" Value="0,0,0,14"/></Style>
<Style x:Key="Page" TargetType="ScrollViewer"><Setter Property="VerticalScrollBarVisibility" Value="Auto"/><Setter Property="Padding" Value="40,34,40,24"/></Style>
<Style TargetType="Hyperlink"><Setter Property="Foreground" Value="{StaticResource StarRail}"/></Style>

<!-- Navigation: the TabControl is drawn as a left rail. Tag carries the game colour (Transparent for non-game pages). -->
<Style TargetType="TabItem">
<Setter Property="Foreground" Value="{StaticResource Text}"/><Setter Property="FocusVisualStyle" Value="{x:Null}"/><Setter Property="Cursor" Value="Hand"/><Setter Property="Tag" Value="Transparent"/>
<Setter Property="Template"><Setter.Value><ControlTemplate TargetType="TabItem">
<Border x:Name="Row" Background="Transparent" CornerRadius="16,4,16,4" Padding="14,10" Margin="12,2,12,2">
<StackPanel Orientation="Horizontal">
<Border x:Name="Marker" Width="3" Height="16" CornerRadius="2" Background="Transparent" Margin="-8,0,9,0"/>
<Ellipse Width="8" Height="8" Margin="0,0,12,0" VerticalAlignment="Center" Fill="{Binding Tag, RelativeSource={RelativeSource TemplatedParent}}"/>
<TextBlock x:Name="Label" Text="{TemplateBinding Header}" Foreground="{StaticResource Muted}" FontSize="14"/></StackPanel></Border>
<ControlTemplate.Triggers>
<Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Label" Property="Foreground" Value="{StaticResource Text}"/></Trigger>
<Trigger Property="IsSelected" Value="True"><Setter TargetName="Marker" Property="Background" Value="{StaticResource Sakura}"/><Setter TargetName="Row" Property="Background" Value="{StaticResource Raised}"/><Setter TargetName="Label" Property="Foreground" Value="{StaticResource Text}"/><Setter TargetName="Label" Property="FontWeight" Value="SemiBold"/></Trigger>
<Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Row" Property="BorderBrush" Value="{StaticResource Muted}"/><Setter TargetName="Row" Property="BorderThickness" Value="1"/></Trigger>
</ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
</Window.Resources>

<Grid>
<!-- Twilight sky: gradient, tiled starfield and two soft glows. Purely decorative; panels keep solid colours. -->
<Rectangle IsHitTestVisible="False"><Rectangle.Fill><LinearGradientBrush StartPoint="0,0" EndPoint="0.3,1"><GradientStop Color="#1B1533" Offset="0"/><GradientStop Color="#2A1E45" Offset="1"/></LinearGradientBrush></Rectangle.Fill></Rectangle>
<Rectangle IsHitTestVisible="False" Opacity="0.75"><Rectangle.Fill><DrawingBrush TileMode="Tile" Viewport="0,0,280,280" ViewportUnits="Absolute" Viewbox="0,0,280,280" ViewboxUnits="Absolute"><DrawingBrush.Drawing><DrawingGroup>
<GeometryDrawing Brush="#00000000" Geometry="M 0,0 H 280 V 280 H 0 Z"/>
<GeometryDrawing Brush="#CCFFFFFF" Geometry="M 22,34 m -1.2,0 a 1.2,1.2 0 1 0 2.4,0 a 1.2,1.2 0 1 0 -2.4,0"/>
<GeometryDrawing Brush="#88FFFFFF" Geometry="M 96,12 m -0.8,0 a 0.8,0.8 0 1 0 1.6,0 a 0.8,0.8 0 1 0 -1.6,0"/>
<GeometryDrawing Brush="#AAFFFFFF" Geometry="M 168,58 m -1,0 a 1,1 0 1 0 2,0 a 1,1 0 1 0 -2,0"/>
<GeometryDrawing Brush="#77FFFFFF" Geometry="M 240,22 m -0.8,0 a 0.8,0.8 0 1 0 1.6,0 a 0.8,0.8 0 1 0 -1.6,0"/>
<GeometryDrawing Brush="#99FFFFFF" Geometry="M 58,120 m -0.9,0 a 0.9,0.9 0 1 0 1.8,0 a 0.9,0.9 0 1 0 -1.8,0"/>
<GeometryDrawing Brush="#CCFFFFFF" Geometry="M 204,140 m -1.3,0 a 1.3,1.3 0 1 0 2.6,0 a 1.3,1.3 0 1 0 -2.6,0"/>
<GeometryDrawing Brush="#77FFFFFF" Geometry="M 132,176 m -0.8,0 a 0.8,0.8 0 1 0 1.6,0 a 0.8,0.8 0 1 0 -1.6,0"/>
<GeometryDrawing Brush="#AAFFFFFF" Geometry="M 30,232 m -1,0 a 1,1 0 1 0 2,0 a 1,1 0 1 0 -2,0"/>
<GeometryDrawing Brush="#88FFFFFF" Geometry="M 256,250 m -0.9,0 a 0.9,0.9 0 1 0 1.8,0 a 0.9,0.9 0 1 0 -1.8,0"/>
<GeometryDrawing Brush="#AAFF9ECF" Geometry="M 110,82 L 111.5,87 L 116.5,88.5 L 111.5,90 L 110,95 L 108.5,90 L 103.5,88.5 L 108.5,87 Z"/>
<GeometryDrawing Brush="#AAC7B4FF" Geometry="M 226,208 L 227.2,212 L 231.2,213.2 L 227.2,214.4 L 226,218.4 L 224.8,214.4 L 220.8,213.2 L 224.8,212 Z"/>
</DrawingGroup></DrawingBrush.Drawing></DrawingBrush></Rectangle.Fill></Rectangle>
<Ellipse IsHitTestVisible="False" Width="760" Height="560" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,-260,-240,0"><Ellipse.Fill><RadialGradientBrush><GradientStop Color="#40FF9ECF" Offset="0"/><GradientStop Color="#00FF9ECF" Offset="1"/></RadialGradientBrush></Ellipse.Fill></Ellipse>
<Ellipse IsHitTestVisible="False" Width="700" Height="520" HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="80,0,0,-280"><Ellipse.Fill><RadialGradientBrush><GradientStop Color="#38B9A6FF" Offset="0"/><GradientStop Color="#00B9A6FF" Offset="1"/></RadialGradientBrush></Ellipse.Fill></Ellipse>
<TabControl x:Name="Navigation" TabStripPlacement="Left" Background="Transparent" BorderThickness="0" Padding="0">
<TabControl.Template><ControlTemplate TargetType="TabControl">
<Grid><Grid.ColumnDefinitions><ColumnDefinition Width="232"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
<Border Background="{StaticResource Rail}"><DockPanel>
<StackPanel DockPanel.Dock="Top" Margin="22,26,18,22" Orientation="Horizontal">
<local:Mascot Width="54" Height="50" Margin="0,0,10,0"/>
<StackPanel VerticalAlignment="Center"><TextBlock Text="VIvian" FontSize="26" FontFamily="{StaticResource Round}" Foreground="{StaticResource Text}"/>
<TextBlock Text="三款游戏，一处出发" Foreground="{StaticResource Sakura}" FontSize="12" Margin="0,2,0,0"/></StackPanel></StackPanel>
<Border DockPanel.Dock="Bottom" Margin="20,12,20,22" Padding="12,10" CornerRadius="8" Background="{StaticResource WarnBack}">
<TextBlock Text="{Binding ExecutionBanner}" Foreground="{StaticResource WarnText}" FontSize="12" LineHeight="18" TextWrapping="Wrap"/></Border>
<TabPanel IsItemsHost="True" Background="{StaticResource Rail}" KeyboardNavigation.TabIndex="1"/></DockPanel></Border>
<Grid Grid.Column="1"><Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
<ContentPresenter ContentSource="SelectedContent"/>
<Grid Grid.Row="1" Margin="40,14,40,16">
<Border Background="#F2201936" BorderBrush="{StaticResource Sakura}" BorderThickness="1.5" CornerRadius="18,4,18,4" Padding="20,18,20,12" Margin="0,12,0,0">
<DockPanel><local:Mascot DockPanel.Dock="Left" Width="34" Height="32" Margin="0,0,14,0" VerticalAlignment="Top"/>
<TextBlock Text="▼" DockPanel.Dock="Right" Foreground="{StaticResource Sakura}" FontSize="10" VerticalAlignment="Bottom" Margin="12,0,0,0"/>
<TextBlock Text="{Binding Status}" Foreground="{StaticResource Text}" FontSize="14" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite"/></DockPanel></Border>
<Border Background="{StaticResource Sakura}" CornerRadius="10" Padding="14,3" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="22,0,0,0">
<TextBlock Text="小星" Foreground="{StaticResource OnAccent}" FontFamily="{StaticResource Round}" FontSize="14"/></Border></Grid></Grid></Grid>
</ControlTemplate></TabControl.Template>

<!-- ============ 今日 ============ -->
<TabItem Header="今日"><ScrollViewer Style="{StaticResource Page}"><StackPanel MaxWidth="1040" HorizontalAlignment="Left">
<Grid Margin="0,0,0,24"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
<local:Mascot Width="132" Height="124" VerticalAlignment="Bottom"/>
<Grid Grid.Column="1" Margin="6,0,0,10" VerticalAlignment="Center" MaxWidth="700" HorizontalAlignment="Left">
<Path Data="M 0,40 L 18,30 L 18,50 Z" Fill="{StaticResource Bubble}" HorizontalAlignment="Left" VerticalAlignment="Top"/>
<Border Background="{StaticResource Bubble}" CornerRadius="22,22,22,6" Padding="24,16,26,18" Margin="17,0,0,0"><StackPanel>
<StackPanel Orientation="Horizontal"><TextBlock Text="おかえり～" Foreground="{StaticResource OnAccent}" FontFamily="{StaticResource JapaneseFont}" FontWeight="SemiBold" FontSize="22"/>
<TextBlock Text="{Binding TodayText}" Foreground="#5A4482" FontFamily="{StaticResource Round}" FontSize="15" VerticalAlignment="Bottom" Margin="14,0,0,3"/></StackPanel>
<TextBlock Text="今天的三段旅程我已经整理好了。星铁可以一键完成日常；原神和绝区零还在接入中，我先帮你看着安装状态。" Foreground="{StaticResource OnAccent}" Margin="0,8,0,0"/>
</StackPanel></Border></Grid></Grid>
<ItemsControl ItemsSource="{Binding Engines}"><ItemsControl.ItemTemplate><DataTemplate>
<Border Background="{StaticResource Surface}" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="20,4,20,4" Margin="0,0,0,12" ClipToBounds="True"><Grid>
<Grid.ColumnDefinitions><ColumnDefinition Width="6"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="64"/></Grid.ColumnDefinitions>
<Border CornerRadius="20,0,0,4" Background="{Binding Accent}"/>
<Rectangle Grid.Column="3" Opacity="0.35" IsHitTestVisible="False"><Rectangle.Fill><LinearGradientBrush StartPoint="0,0" EndPoint="9,9" MappingMode="Absolute" SpreadMethod="Repeat"><GradientStop Color="{Binding Accent}" Offset="0"/><GradientStop Color="{Binding Accent}" Offset="0.45"/><GradientStop Color="Transparent" Offset="0.45"/><GradientStop Color="Transparent" Offset="1"/></LinearGradientBrush></Rectangle.Fill></Rectangle>
<StackPanel Grid.Column="1" Margin="22,16,12,16">
<TextBlock Text="{Binding Name}" FontSize="20" FontFamily="{StaticResource Round}"/>
<TextBlock Text="{Binding Version}" Style="{StaticResource Small}" Margin="0,2,0,6"/>
<TextBlock Text="{Binding Execution}" Style="{StaticResource Small}"/>
<TextBlock Text="{Binding LastRun}" Style="{StaticResource Small}"/></StackPanel>
<TextBlock Grid.Column="2" Text="{Binding Compatibility}" Foreground="{Binding StateBrush}" FontWeight="SemiBold" Margin="12,18,12,0" MaxWidth="240" AutomationProperties.Name="引擎状态"/>
</Grid></Border></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
<Border Style="{StaticResource Panel}" Margin="0,10,0,14" Visibility="{Binding M5Visibility}"><StackPanel>
<TextBlock Text="开始星铁日常" Style="{StaticResource H2}"/>
<TextBlock Text="清体力、每日实训、领取奖励，一次完成。详细配置与运行日志在“崩坏：星穹铁道”页。" Style="{StaticResource Small}" Margin="0,0,0,12"/>
<TextBlock Text="{Binding ManualTestStateText}" Foreground="{StaticResource Warn}" FontWeight="SemiBold" AutomationProperties.LiveSetting="Polite"/>
<TextBlock Text="{Binding LastRealResultText}" Style="{StaticResource Small}" Margin="0,4,0,12"/>
<CheckBox IsChecked="{Binding March7thConfirmedThisRun}" Content="我确认本次真实游戏任务：日常（清体力 + 每日实训 + 领奖）" AutomationProperties.Name="确认本次星铁日常"/>
<CheckBox IsChecked="{Binding AllowTemporaryConfigurationThisRun}" Content="{Binding TemporaryConfigurationText}" Visibility="{Binding TemporaryConfigurationVisibility}" Margin="0,8,0,0" AutomationProperties.Name="允许本次临时修改上游设置"/>
<StackPanel Visibility="{Binding PendingRestoreVisibility}" Margin="0,8,0,0"><TextBlock Text="{Binding PendingRestoreText}" Foreground="{StaticResource Warn}"/>
<Button Content="恢复临时配置" Command="{Binding RestoreConfigurationCommand}" HorizontalAlignment="Left" Margin="0,8,0,0" AutomationProperties.Name="恢复临时配置"/></StackPanel>
<WrapPanel Margin="0,16,0,0"><Button Style="{StaticResource Primary}" Content="开始日常" Command="{Binding StartMarch7thCommand}" IsEnabled="{Binding CanStartMarch7th}"/>
<Button Style="{StaticResource DangerButton}" Content="停止" Command="{Binding Queue.StopCommand}" IsEnabled="{Binding Queue.IsRunning}"/>
<Button Content="保存反馈" Command="{Binding SaveFeedbackCommand}"/></WrapPanel>
<TextBlock Text="需要 UAC 时由你本人决定。打开 VIvian 不会自动运行游戏。" Style="{StaticResource Small}" Margin="0,10,0,0"/>
</StackPanel></Border>
<WrapPanel IsEnabled="{Binding IsIdle}"><Button Content="重新检查三款引擎" Command="{Binding CheckEnginesCommand}" Margin="0,0,10,8"/><Button Content="运行基础自检" Command="{Binding CheckCommand}" Margin="0,0,10,8"/>
<TextBlock Text="只读取文件信息，不启动任何程序或游戏" VerticalAlignment="Center" Style="{StaticResource Small}"/></WrapPanel>
</StackPanel></ScrollViewer></TabItem>

<!-- ============ 崩坏：星穹铁道 ============ -->
<TabItem Header="崩坏：星穹铁道" Tag="{StaticResource StarRail}"><Grid Margin="40,34,24,0">
<Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
<Grid.ColumnDefinitions><ColumnDefinition Width="5*"/><ColumnDefinition Width="6*"/></Grid.ColumnDefinitions>
<StackPanel Grid.ColumnSpan="2"><StackPanel Orientation="Horizontal"><TextBlock Text="崩坏：星穹铁道" Style="{StaticResource H1}"/><TextBlock Text="スターレイル" Style="{StaticResource Kana}"/></StackPanel>
<TextBlock Text="{Binding Engines[1].Version, StringFormat=由 {0} 执行。VIvian 读取并修改它的真实配置，原软件里的修改也会自动同步回来。}" Style="{StaticResource Lead}"/></StackPanel>

<ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="0,0,16,0" Padding="0,0,0,20"><StackPanel>
<Border Style="{StaticResource Panel}"><StackPanel>
<TextBlock Text="{Binding March7thTask.Title}" Style="{StaticResource H2}"/>
<TextBlock Text="按右侧“清体力”设置的副本消耗开拓力（需要时借用支援角色），再做每日实训并领取奖励。开拓力不少于 120 才能拿满 500 分。" Style="{StaticResource Small}" Margin="0,0,0,14"/>
<TextBlock Text="{Binding ManualTestStateText}" Foreground="{StaticResource Warn}" FontWeight="SemiBold" AutomationProperties.LiveSetting="Polite"/>
<TextBlock Text="{Binding LastRealResultText}" Style="{StaticResource Small}" Margin="0,4,0,14" AutomationProperties.LiveSetting="Polite"/>
<CheckBox IsChecked="{Binding March7thConfirmedThisRun}" Content="我确认本次真实游戏任务" AutomationProperties.Name="确认本次星铁真实任务"/>
<CheckBox IsChecked="{Binding AllowTemporaryConfigurationThisRun}" Content="{Binding TemporaryConfigurationText}" Visibility="{Binding TemporaryConfigurationVisibility}" Margin="0,8,0,0"/>
<StackPanel Visibility="{Binding PendingRestoreVisibility}" Margin="0,8,0,0"><TextBlock Text="{Binding PendingRestoreText}" Foreground="{StaticResource Warn}"/>
<Button Content="恢复临时配置" Command="{Binding RestoreConfigurationCommand}" HorizontalAlignment="Left" Margin="0,8,0,0"/></StackPanel>
<WrapPanel Margin="0,16,0,0"><Button Style="{StaticResource Primary}" Content="{Binding StartButtonText}" Command="{Binding StartMarch7thCommand}" IsEnabled="{Binding CanStartMarch7th}"/>
<Button Style="{StaticResource DangerButton}" Content="紧急停止" Command="{Binding Queue.StopCommand}" IsEnabled="{Binding Queue.IsRunning}"/></WrapPanel>
<TextBlock Text="{Binding March7thConsentNote}" Style="{StaticResource Small}" Margin="0,12,0,0"/>
</StackPanel></Border>

<Border Style="{StaticResource Panel}"><StackPanel>
<TextBlock Text="运行过程" Style="{StaticResource H2}"/>
<TextBlock Text="{Binding Queue.Current}"/>
<TextBlock Text="{Binding Queue.Status}" Style="{StaticResource Small}" Margin="0,2,0,10"/>
<ListBox ItemsSource="{Binding Queue.LogLines}" Height="220" FontFamily="Consolas, Microsoft YaHei UI" FontSize="12" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
<ListBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding}" TextWrapping="Wrap" FontSize="12" LineHeight="18"/></DataTemplate></ListBox.ItemTemplate></ListBox>
<WrapPanel Margin="0,12,0,0" IsEnabled="{Binding IsIdle}"><Button Content="导出诊断报告" Command="{Binding ExportDiagnosticsCommand}"/></WrapPanel>
<TextBlock Text="{Binding ExportStatus}" Style="{StaticResource Small}" Margin="0,8,0,0"/>
</StackPanel></Border>

<Expander><Expander.Header><TextBlock Text="安装核验与安全细节" Foreground="{StaticResource Muted}"/></Expander.Header>
<StackPanel Margin="0,10,0,0">
<TextBlock Text="{Binding March7thExecutionBlock}" Style="{StaticResource Small}"/>
<TextBlock Text="{Binding Engines[1].InstallPath, StringFormat=安装目录：{0}}" Style="{StaticResource Small}" Margin="0,6,0,0"/>
<TextBlock Text="{Binding Engines[1].Compatibility, StringFormat=安装检查：{0}}" Style="{StaticResource Small}"/>
<TextBlock Text="{Binding ReleaseStatus}" Style="{StaticResource Small}"/>
<TextBlock Text="{Binding March7thStopStatus}" Style="{StaticResource Small}"/>
<TextBlock Text="{Binding VersionText}" Style="{StaticResource Small}" Margin="0,6,0,0"/>
<TextBlock Text="{Binding DiagnosticSessionText}" Style="{StaticResource Small}"/>
</StackPanel></Expander>
</StackPanel></ScrollViewer>

<DockPanel Grid.Row="1" Grid.Column="1" DataContext="{Binding Configuration}" Margin="0,0,0,0">
<StackPanel DockPanel.Dock="Top" Margin="0,0,16,10">
<Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
<TextBlock Text="配置" Style="{StaticResource H2}" VerticalAlignment="Center" Margin="0"/>
<WrapPanel Grid.Column="1"><Button Content="重新读取" Command="{Binding ReadCommand}" Margin="0,0,8,0"/><Button Style="{StaticResource Primary}" Content="预览并保存修改" Command="{Binding SaveCommand}" Margin="0,0,8,0"/><Button Content="复制设置文件路径" Command="{Binding OpenSettingsCommand}" Margin="0"/></WrapPanel></Grid>
<TextBlock Text="{Binding Status}" Style="{StaticResource Small}" Margin="0,8,0,0" AutomationProperties.LiveSetting="Polite"/></StackPanel>
<ScrollViewer VerticalScrollBarVisibility="Auto" Padding="0,0,16,20">
<ScrollViewer.Resources><CollectionViewSource x:Key="Grouped" Source="{Binding Parameters}"><CollectionViewSource.GroupDescriptions><PropertyGroupDescription PropertyName="Group"/></CollectionViewSource.GroupDescriptions></CollectionViewSource></ScrollViewer.Resources>
<ItemsControl ItemsSource="{Binding Source={StaticResource Grouped}}">
<ItemsControl.GroupStyle><GroupStyle><GroupStyle.HeaderTemplate><DataTemplate>
<TextBlock Text="{Binding Name, StringFormat=✦ {0}}" FontSize="16" FontFamily="{StaticResource Round}" Foreground="{StaticResource Sakura}" Margin="0,20,0,6"/></DataTemplate></GroupStyle.HeaderTemplate></GroupStyle></ItemsControl.GroupStyle>
<ItemsControl.ItemTemplate><DataTemplate>
<Border BorderBrush="{StaticResource Line}" BorderThickness="0,0,0,1" Padding="0,10,0,12"><Grid>
<Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="210"/></Grid.ColumnDefinitions>
<StackPanel Margin="0,0,18,0" ToolTip="{Binding Dependencies}">
<TextBlock Text="{Binding Title}" FontWeight="SemiBold"/>
<TextBlock Text="{Binding Description}" Style="{StaticResource Small}" Margin="0,2,0,0"/>
<TextBlock Text="{Binding State}" Foreground="{StaticResource Warn}" FontSize="12" Margin="0,4,0,0" Visibility="{Binding IsReadOnlyDisplay, Converter={StaticResource Visible}}"/></StackPanel>
<Grid Grid.Column="1" VerticalAlignment="Center">
<CheckBox Style="{StaticResource Switch}" IsChecked="{Binding BoolValue}" IsEnabled="{Binding Editable}" HorizontalAlignment="Right" Visibility="{Binding IsBoolean, Converter={StaticResource Visible}}" AutomationProperties.Name="{Binding Title}"/>
<ComboBox ItemsSource="{Binding Options}" DisplayMemberPath="Label" SelectedValuePath="Value" SelectedValue="{Binding Current}" IsEnabled="{Binding Editable}" Visibility="{Binding IsChoice, Converter={StaticResource Visible}}" AutomationProperties.Name="{Binding Title}"/>
<TextBox Text="{Binding Current, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding Editable}" ToolTip="{Binding Rule}" Visibility="{Binding IsTextual, Converter={StaticResource Visible}}" AutomationProperties.Name="{Binding Title}"/>
<TextBlock Text="由原软件管理" Style="{StaticResource Small}" HorizontalAlignment="Right" Visibility="{Binding IsReadOnlyDisplay, Converter={StaticResource Visible}}"/></Grid>
</Grid></Border></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></ScrollViewer></DockPanel>
</Grid></TabItem>

<!-- ============ 原神 ============ -->
<TabItem Header="原神" Tag="{StaticResource Genshin}"><ScrollViewer Style="{StaticResource Page}"><StackPanel MaxWidth="900" HorizontalAlignment="Left" DataContext="{Binding Engines[0]}">
<StackPanel Orientation="Horizontal"><TextBlock Text="原神" Style="{StaticResource H1}"/><TextBlock Text="げんしん" Style="{StaticResource Kana}"/></StackPanel>
<TextBlock Text="{Binding Version, StringFormat=由 {0} 执行。正在接入：目前只读取安装状态，不会运行它。}" Style="{StaticResource Lead}"/>
<Border Style="{StaticResource Panel}"><StackPanel>
<TextBlock Text="{Binding Compatibility}" Foreground="{Binding StateBrush}" FontSize="18" FontWeight="SemiBold"/>
<TextBlock Text="{Binding DetectedVersion}" Style="{StaticResource Small}" Margin="0,6,0,0"/>
<TextBlock Text="{Binding Evidence}" Style="{StaticResource Small}"/></StackPanel></Border>
<Border Style="{StaticResource Panel}"><StackPanel>
<TextBlock Text="接下来会做到" Style="{StaticResource H2}"/>
<TextBlock Text="读取 BetterGI 已有的一条龙方案与配置组，在这里选择今天要跑哪一套。" Style="{StaticResource Small}"/>
<TextBlock Text="对任务开关等已核对的参数提供修改与双向同步；复杂脚本仍在原软件中编辑。" Style="{StaticResource Small}" Margin="0,4,0,0"/>
<TextBlock Text="确认启动、提权、日志对应和进程清理之后，再开放真实执行。" Style="{StaticResource Small}" Margin="0,4,0,0"/></StackPanel></Border>
</StackPanel></ScrollViewer></TabItem>

<!-- ============ 绝区零 ============ -->
<TabItem Header="绝区零" Tag="{StaticResource Zenless}"><ScrollViewer Style="{StaticResource Page}"><StackPanel MaxWidth="900" HorizontalAlignment="Left" DataContext="{Binding Engines[2]}">
<StackPanel Orientation="Horizontal"><TextBlock Text="绝区零" Style="{StaticResource H1}"/><TextBlock Text="ゼンレスゾーンゼロ" Style="{StaticResource Kana}"/></StackPanel>
<TextBlock Text="{Binding Version, StringFormat=由 {0} 执行。正在接入：目前只读取安装状态，不会运行它。}" Style="{StaticResource Lead}"/>
<Border Style="{StaticResource Panel}"><StackPanel>
<TextBlock Text="{Binding Compatibility}" Foreground="{Binding StateBrush}" FontSize="18" FontWeight="SemiBold"/>
<TextBlock Text="{Binding DetectedVersion}" Style="{StaticResource Small}" Margin="0,6,0,0"/>
<TextBlock Text="{Binding Evidence}" Style="{StaticResource Small}"/></StackPanel></Border>
<Border Style="{StaticResource Panel}"><StackPanel>
<TextBlock Text="接下来会做到" Style="{StaticResource H2}"/>
<TextBlock Text="明确选择账号实例：任何修改只作用于你选中的那个账号。" Style="{StaticResource Small}"/>
<TextBlock Text="读取应用组、日常开关、体力计划和战斗预设，并提供已核对参数的修改与同步。" Style="{StaticResource Small}" Margin="0,4,0,0"/>
<TextBlock Text="按 OneDragon v2.6.0 的真实要求核对安装目录，再开放应用组的真实执行。" Style="{StaticResource Small}" Margin="0,4,0,0"/></StackPanel></Border>
</StackPanel></ScrollViewer></TabItem>

<!-- ============ 运行记录 ============ -->
<TabItem Header="运行记录"><Grid Margin="40,34,40,20" DataContext="{Binding Queue}">
<Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
<StackPanel><StackPanel Orientation="Horizontal"><TextBlock Text="运行记录" Style="{StaticResource H1}"/><TextBlock Text="きろく" Style="{StaticResource Kana}"/></StackPanel>
<TextBlock Text="每次运行的结果和清理状态分开记录。结果写“未知”时，表示没有找到足够的完成证据，VIvian 不会把它当作成功。" Style="{StaticResource Lead}"/></StackPanel>
<Border Grid.Row="1" Background="{StaticResource DangerBack}" CornerRadius="10" Padding="16,12" Margin="0,0,0,14">
<Border.Style><Style TargetType="Border"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding HasUnresolved}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></Border.Style>
<StackPanel><TextBlock Text="有运行无法确认已清理。在你确认之前，新的任务不会启动。" Foreground="{StaticResource DangerText}" FontWeight="SemiBold"/>
<TextBlock Text="请先确认相关引擎和游戏都已关闭。你的确认会单独记录，不会改写原判定。" Foreground="{StaticResource DangerText}" Margin="0,4,0,10"/>
<Button Content="我已确认，全部已关闭" Command="{Binding AcknowledgeCommand}" IsEnabled="{Binding IsIdle}" HorizontalAlignment="Left"/></StackPanel></Border>
<Grid Grid.Row="2"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
<DockPanel Margin="0,0,10,0"><TextBlock DockPanel.Dock="Top" Text="历史" Style="{StaticResource H2}"/>
<ListView ItemsSource="{Binding Runs}" HorizontalContentAlignment="Stretch" ScrollViewer.HorizontalScrollBarVisibility="Disabled"><ListView.ItemTemplate><DataTemplate>
<Border BorderBrush="{StaticResource Line}" BorderThickness="0,0,0,1" Padding="4,8,4,10"><StackPanel>
<TextBlock Text="{Binding When}" Foreground="{StaticResource StarRail}" FontSize="13"/><TextBlock Text="{Binding Summary}" Margin="0,2,0,0"/>
<TextBlock Text="{Binding RunId, StringFormat=RunId {0:D}}" Style="{StaticResource Small}" FontSize="12"/></StackPanel></Border>
</DataTemplate></ListView.ItemTemplate></ListView></DockPanel>
<DockPanel Grid.Column="1" Margin="10,0,0,0"><TextBlock DockPanel.Dock="Top" Text="日志" Style="{StaticResource H2}"/>
<TextBlock DockPanel.Dock="Bottom" Text="{Binding Status}" Style="{StaticResource Small}" Margin="0,8,0,0" AutomationProperties.LiveSetting="Polite"/>
<ListBox ItemsSource="{Binding LogLines}" FontFamily="Consolas, Microsoft YaHei UI" VirtualizingPanel.IsVirtualizing="True" ScrollViewer.HorizontalScrollBarVisibility="Disabled"><ListBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding}" TextWrapping="Wrap" FontSize="12" LineHeight="18"/></DataTemplate></ListBox.ItemTemplate></ListBox></DockPanel></Grid>
<Expander Grid.Row="3" Margin="0,14,0,0"><Expander.Header><TextBlock Text="模拟队列：只用于检验调度、停止与清理逻辑，不会启动游戏" Foreground="{StaticResource Muted}"/></Expander.Header>
<Grid Margin="0,10,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
<ItemsControl ItemsSource="{Binding Games}" IsEnabled="{Binding IsIdle}"><ItemsControl.ItemTemplate><DataTemplate>
<Border Background="{StaticResource Surface}" CornerRadius="8" Padding="14,8" Margin="0,0,0,6"><Grid>
<Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
<CheckBox IsChecked="{Binding Include}" VerticalAlignment="Center" AutomationProperties.Name="{Binding Name}"/>
<TextBlock Grid.Column="1" Text="{Binding Name}" VerticalAlignment="Center" Margin="4,0,12,0"/>
<ComboBox Grid.Column="2" MinWidth="200" ItemsSource="{Binding Source={x:Static local:DemoGameOption.Scenarios}}" DisplayMemberPath="Label" SelectedItem="{Binding Scenario}" AutomationProperties.Name="模拟情形"/>
</Grid></Border></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
<StackPanel Grid.Column="1" Margin="14,0,0,0" MinWidth="170">
<Button Content="开始模拟队列" Command="{Binding StartCommand}" IsEnabled="{Binding IsIdle}" Margin="0,0,0,8"/>
<Button Style="{StaticResource DangerButton}" Content="紧急停止" Command="{Binding StopCommand}" IsEnabled="{Binding IsRunning}" Margin="0,0,0,8" AutomationProperties.HelpText="立即停止，不倒计时"/>
<TextBlock Text="{Binding Current}" Style="{StaticResource Small}" AutomationProperties.LiveSetting="Polite"/></StackPanel></Grid></Expander>
</Grid></TabItem>

<!-- ============ 任务计划 ============ -->
<TabItem Header="任务计划"><Grid Margin="40,34,40,20">
<Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
<StackPanel><StackPanel Orientation="Horizontal"><TextBlock Text="任务计划" Style="{StaticResource H1}"/><TextBlock Text="けいかく" Style="{StaticResource Kana}"/></StackPanel>
<TextBlock Text="按游戏勾选要做的任务并排好顺序。计划只记录你的选择；标为“候选”的任务还没核对，不会被执行。" Style="{StaticResource Lead}"/></StackPanel>
<ComboBox Grid.Row="1" ItemsSource="{Binding TaskPlans}" SelectedItem="{Binding SelectedPlan}" DisplayMemberPath="Name" Width="320" HorizontalAlignment="Left" Margin="0,0,0,12" AutomationProperties.Name="选择游戏"/>
<Grid Grid.Row="2" DataContext="{Binding SelectedPlan}"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
<ListBox ItemsSource="{Binding Rows}" SelectedItem="{Binding Selected}" Background="{StaticResource Surface}" HorizontalContentAlignment="Stretch" ScrollViewer.HorizontalScrollBarVisibility="Disabled" AutomationProperties.Name="任务列表"><ListBox.ItemTemplate><DataTemplate>
<Grid Margin="10,8"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
<CheckBox IsChecked="{Binding Enabled}" VerticalAlignment="Center" AutomationProperties.Name="{Binding Title}"/>
<StackPanel Grid.Column="1" Margin="4,0,12,0"><TextBlock Text="{Binding Title}" FontSize="15"/><TextBlock Text="{Binding Note}" Style="{StaticResource Small}" FontSize="12"/></StackPanel>
<TextBlock Grid.Column="2" Text="{Binding Status}" Foreground="{StaticResource Warn}" VerticalAlignment="Center" FontSize="13"/>
</Grid></DataTemplate></ListBox.ItemTemplate></ListBox>
<StackPanel Grid.Column="1" Margin="14,0,0,0" MinWidth="120">
<Button Content="上移" Command="{Binding DataContext.MoveUpCommand, RelativeSource={RelativeSource AncestorType=Window}}" Margin="0,0,0,8"/>
<Button Content="下移" Command="{Binding DataContext.MoveDownCommand, RelativeSource={RelativeSource AncestorType=Window}}" Margin="0,0,0,8"/></StackPanel></Grid>
<StackPanel Grid.Row="3" Margin="0,12,0,0">
<TextBlock Text="{Binding SelectedPlan.Validation}" Foreground="{StaticResource Warn}" Margin="0,0,0,10" AutomationProperties.LiveSetting="Polite"/>
<WrapPanel IsEnabled="{Binding IsIdle}"><Button Style="{StaticResource Primary}" Content="保存计划" Command="{Binding SaveTasksCommand}"/><Button Content="放弃修改" Command="{Binding ReloadTasksCommand}"/></WrapPanel></StackPanel>
</Grid></TabItem>

<!-- ============ AI 助手 ============ -->
<TabItem Header="AI 助手"><ScrollViewer Style="{StaticResource Page}"><StackPanel MaxWidth="820" HorizontalAlignment="Left">
<StackPanel Orientation="Horizontal"><TextBlock Text="AI 助手" Style="{StaticResource H1}"/><TextBlock Text="アシスタント" Style="{StaticResource Kana}"/></StackPanel>
<TextBlock Text="以后你可以直接告诉 VIvian 想做什么，比如“星铁先清体力再领奖，每周一打历战余响”。这一功能正在开发，目前还不能对话。" Style="{StaticResource Lead}"/>
<Border Style="{StaticResource Panel}"><StackPanel>
<TextBlock Text="一次请求会经过这四步" Style="{StaticResource H2}"/>
<TextBlock Text="1. 理解你的要求，拆成三款游戏里具体的任务和参数。" Margin="0,4,0,0"/>
<TextBlock Text="2. 读取真实的任务目录和当前配置，检查版本、依赖和冲突。缺少条件时先问你。" Margin="0,4,0,0"/>
<TextBlock Text="3. 给出修改预览（改哪些项、从什么改成什么），等你确认后才写入，并自动备份。" Margin="0,4,0,0"/>
<TextBlock Text="4. 通过和你手动操作完全相同的执行系统运行，并解释结果和失败原因。" Margin="0,4,0,0"/></StackPanel></Border>
<Border Style="{StaticResource Panel}"><StackPanel>
<TextBlock Text="AI 能做和不能做的事" Style="{StaticResource H2}"/>
<TextBlock Text="只能调用 VIvian 提供的受控功能：查任务、读配置、提出修改、校验、在你授权后保存和执行。它不能任意读写文件，也不能运行命令行。" Style="{StaticResource Small}"/>
<TextBlock Text="你可以选择三种授权：只给建议；每次修改前先确认；或者允许它在你划定的范围内直接修改已核对的低风险开关。删除配置、消耗燃料等不可撤销的操作始终要你确认。" Style="{StaticResource Small}" Margin="0,8,0,0"/></StackPanel></Border>
</StackPanel></ScrollViewer></TabItem>

<!-- ============ 引擎与安装 ============ -->
<TabItem Header="引擎与安装"><ScrollViewer Style="{StaticResource Page}"><StackPanel IsEnabled="{Binding IsIdle}" MaxWidth="980" HorizontalAlignment="Left">
<StackPanel Orientation="Horizontal"><TextBlock Text="引擎与安装" Style="{StaticResource H1}"/><TextBlock Text="エンジン" Style="{StaticResource Kana}"/></StackPanel>
<TextBlock Text="VIvian 启动时会自动找到三款引擎并核对固定版本。只有自动发现失败时才需要手动填写目录。检查全程只读，不会运行任何程序。" Style="{StaticResource Lead}"/>
<ItemsControl ItemsSource="{Binding Engines}"><ItemsControl.ItemTemplate><DataTemplate><Border Style="{StaticResource Panel}"><StackPanel>
<Grid><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
<Ellipse Width="10" Height="10" Fill="{Binding Accent}" VerticalAlignment="Center" Margin="0,0,12,0"/>
<TextBlock Grid.Column="1" Text="{Binding Name}" FontSize="18" FontWeight="SemiBold"/><TextBlock Grid.Column="2" Text="{Binding Compatibility}" Foreground="{Binding StateBrush}" FontWeight="SemiBold"/></Grid>
<TextBlock Text="{Binding PinnedVersion}" Style="{StaticResource Small}" Margin="0,4,0,12"/>
<DockPanel><Button DockPanel.Dock="Right" Content="浏览…" Click="BrowseEngineFolder" Tag="{Binding}" Margin="8,0,0,0"/>
<TextBox Text="{Binding InstallPath, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="{Binding Name}" ToolTip="引擎安装目录"/></DockPanel>
<TextBlock Text="{Binding DetectedVersion}" Style="{StaticResource Small}" Margin="0,10,0,0"/>
<TextBlock Text="{Binding PendingWarning}" Foreground="{StaticResource Warn}" FontSize="13" Margin="0,4,0,0"><TextBlock.Style><Style TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}"><Style.Triggers><Trigger Property="Text" Value=""><Setter Property="Visibility" Value="Collapsed"/></Trigger></Style.Triggers></Style></TextBlock.Style></TextBlock>
<Expander><Expander.Header><TextBlock Text="检查详情" Foreground="{StaticResource Muted}"/></Expander.Header><ItemsControl ItemsSource="{Binding Checks}" Margin="0,8,0,0"><ItemsControl.ItemTemplate><DataTemplate>
<Grid Margin="0,0,0,8"><Grid.ColumnDefinitions><ColumnDefinition Width="90"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
<TextBlock Text="{Binding State}" Foreground="{Binding Brush}" FontWeight="SemiBold"/>
<StackPanel Grid.Column="1"><TextBlock Text="{Binding Title}" FontWeight="SemiBold"/><TextBlock Text="{Binding Message}" Style="{StaticResource Small}"/><TextBlock Text="{Binding Action}" Foreground="{StaticResource StarRail}" FontSize="13"/></StackPanel>
</Grid></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></Expander>
<Expander><Expander.Header><TextBlock Text="能力与证据" Foreground="{StaticResource Muted}"/></Expander.Header><ItemsControl ItemsSource="{Binding Capabilities}" Margin="0,8,0,0"><ItemsControl.ItemTemplate><DataTemplate>
<Grid Margin="0,0,0,8"><Grid.ColumnDefinitions><ColumnDefinition Width="220"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
<StackPanel><TextBlock Text="{Binding Title}" FontWeight="SemiBold"/><TextBlock Text="{Binding Status}" Foreground="{Binding Brush}" FontSize="13"/></StackPanel>
<TextBlock Grid.Column="1" Text="{Binding Note}" Style="{StaticResource Small}" Margin="10,0,0,0"/>
</Grid></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></Expander>
</StackPanel></Border></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
<WrapPanel Margin="0,4,0,14"><Button Content="自动填入已发现目录" Command="{Binding AutoDiscoverCommand}" Margin="0,0,10,8"/><Button Style="{StaticResource Primary}" Content="保存路径并检查" Command="{Binding SaveCommand}" Margin="0,0,10,8"/><Button Content="重新检查" Command="{Binding CheckEnginesCommand}" Margin="0,0,10,8"/><Button Content="放弃未保存的修改" Command="{Binding ReloadCommand}" Margin="0,0,10,8"/></WrapPanel>
<Border Style="{StaticResource Panel}"><StackPanel>
<TextBlock Text="星铁官方发行包" Style="{StaticResource H2}"/>
<TextBlock Text="VIvian 用官方 March7thAssistant_full.zip（v2026.10.31）的 SHA-256 核对安装目录里的 m7a.exe。不解压，不运行；位置会被记住，每次启动自动核对。" Style="{StaticResource Small}" Margin="0,0,0,10"/>
<DockPanel><Button DockPanel.Dock="Right" Content="浏览…" Click="BrowseReleaseArchive" Margin="8,0,0,0"/><TextBox Text="{Binding ReleaseArchivePath, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="官方发行包路径" ToolTip="官方发行包文件路径"/></DockPanel>
<WrapPanel Margin="0,10,0,0"><Button Content="核对发行包" Command="{Binding VerifyReleaseCommand}"/></WrapPanel>
<TextBlock Text="{Binding ReleaseStatus}" Style="{StaticResource Small}" Margin="0,8,0,0"/>
</StackPanel></Border>
</StackPanel></ScrollViewer></TabItem>

<!-- ============ 设置 ============ -->
<TabItem Header="设置与诊断"><ScrollViewer Style="{StaticResource Page}"><StackPanel IsEnabled="{Binding IsIdle}" MaxWidth="900" HorizontalAlignment="Left">
<StackPanel Orientation="Horizontal"><TextBlock Text="设置与诊断" Style="{StaticResource H1}"/><TextBlock Text="せってい" Style="{StaticResource Kana}"/></StackPanel>
<TextBlock Text="{Binding VersionText}" Style="{StaticResource Lead}" Margin="0,6,0,2"/>
<TextBlock Text="{Binding DataDirectoryText}" Style="{StaticResource Small}" Margin="0,0,0,20"/>
<Border Style="{StaticResource Panel}"><StackPanel>
<TextBlock Text="偏好" Style="{StaticResource H2}"/>
<DockPanel Margin="0,6,0,12"><TextBlock Text="日志保留天数（3–90）" VerticalAlignment="Center" Margin="0,0,12,0"/><TextBox Text="{Binding LogRetentionDays, UpdateSourceTrigger=PropertyChanged}" Width="80" HorizontalAlignment="Left" AutomationProperties.Name="日志保留天数"/></DockPanel>
<CheckBox IsChecked="{Binding IncludeRunHistory}" Content="诊断包中包含运行记录（只有状态与原因代码）" AutomationProperties.Name="诊断包包含运行记录" Margin="0,0,0,14"/>
<WrapPanel><Button Style="{StaticResource Primary}" Content="保存设置" Command="{Binding SavePreferencesCommand}"/></WrapPanel></StackPanel></Border>
<Border Style="{StaticResource Panel}"><StackPanel>
<TextBlock Text="诊断" Style="{StaticResource H2}"/>
<TextBlock Text="导出本地 ZIP：版本、引擎检查、运行记录与最近日志。用户名、计算机名、口令与令牌已去除；不含数据库、上游配置或账号信息，也不会自动上传。" Style="{StaticResource Small}" Margin="0,0,0,12"/>
<WrapPanel><Button Content="导出诊断包" Command="{Binding ExportDiagnosticsCommand}" Margin="0,0,10,8"/><Button Content="复制导出文件夹路径" Click="CopyExportsPath" Margin="0,0,10,8"/><Button Content="复制日志文件夹路径" Click="CopyLogsPath" Margin="0,0,10,8"/></WrapPanel>
<TextBlock Text="{Binding ExportStatus}" Style="{StaticResource Small}" AutomationProperties.LiveSetting="Polite"/></StackPanel></Border>
<Border Style="{StaticResource Panel}"><StackPanel>
<Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
<TextBlock Text="基础自检记录" Style="{StaticResource H2}"/><Button Grid.Column="1" Content="刷新" Command="{Binding ReloadCommand}" IsEnabled="{Binding IsIdle}" Margin="0"/></Grid>
<TextBlock Text="这里不是游戏任务历史。时间为 UTC。" Style="{StaticResource Small}" Margin="0,0,0,8"/>
<ListView ItemsSource="{Binding History}" MaxHeight="240" Background="{StaticResource Surface}" HorizontalContentAlignment="Stretch" ScrollViewer.HorizontalScrollBarVisibility="Disabled"><ListView.ItemTemplate><DataTemplate><StackPanel Margin="0,6"><TextBlock Text="{Binding StartedAt, StringFormat={}{0:yyyy-MM-dd HH:mm:ss} UTC}" Foreground="{StaticResource StarRail}" FontSize="13"/><TextBlock Text="{Binding Summary}" Style="{StaticResource Small}"/></StackPanel></DataTemplate></ListView.ItemTemplate></ListView>
</StackPanel></Border>
<Border Style="{StaticResource Panel}"><StackPanel>
<TextBlock Text="关于" Style="{StaticResource H2}"/>
<TextBlock Text="VIvian 是三款开源自动化工具的统一控制中心：BetterGI v0.66.0、March7thAssistant v2026.10.31、ZenlessZoneZero-OneDragon v2.6.0。识别、战斗和寻路由它们完成，VIvian 负责配置、编排和结果核验。" Style="{StaticResource Small}"/>
<TextBlock Text="以普通用户权限运行，不会静默提权；引擎只从官方 GitHub Release 获取；不要把引擎放在符号链接或目录联接后面。OneDragon 官方要求安装路径只含英文字母、数字、下划线和连字符。" Style="{StaticResource Small}" Margin="0,8,0,0"/>
<TextBlock Text="本程序与游戏官方无关，不收集游戏密码，不自动上传诊断信息。游戏自动化存在账号处罚风险，VIvian 不承诺零风险，也不会绕过反作弊。" Foreground="{StaticResource Warn}" FontSize="13" Margin="0,8,0,0"/></StackPanel></Border>
</StackPanel></ScrollViewer></TabItem>
</TabControl></Grid></Window>
