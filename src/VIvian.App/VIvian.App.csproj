<Project Sdk="Microsoft.NET.Sdk">
<PropertyGroup>
<TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
<OutputType>WinExe</OutputType><UseWPF>true</UseWPF>
<EnableWindowsTargeting>true</EnableWindowsTargeting>
<ApplicationManifest>app.manifest</ApplicationManifest>
<ApplicationIcon>Assets\Furina\furina-app.ico</ApplicationIcon>
    <!-- M5 real-execution builds ask for administrator rights once, when VIvian is opened. Star Rail and
         March7thAssistant run elevated; an elevated VIvian lets a whole multi-account batch run without a UAC
         prompt per account. Development builds stay asInvoker. -->
    <ApplicationManifest Condition="'$(M5DailyTestBuild)' == 'true'">app.admin.manifest</ApplicationManifest>
<AssemblyName>VIvian</AssemblyName><Version>0.4.0</Version><InformationalVersion>0.4.0-dev</InformationalVersion>
</PropertyGroup>
<PropertyGroup Condition="'$(GenshinRewardAcceptanceBuild)' == 'true'">
<DefineConstants>$(DefineConstants);VIVIAN_GENSHIN_REWARD_ACCEPTANCE</DefineConstants>
</PropertyGroup>
<ItemGroup>
<InternalsVisibleTo Include="VIvian.Tests" />
<ProjectReference Include="../VIvian.Infrastructure/VIvian.Infrastructure.csproj" />
<PackageReference Include="Microsoft.Extensions.Hosting" Version="10.0.14" />
<PackageReference Include="Serilog.Extensions.Hosting" Version="10.0.0" />
<PackageReference Include="Serilog.Sinks.File" Version="7.0.0" />
<PackageReference Include="XamlAnimatedGif" Version="2.3.2" />
</ItemGroup>
<ItemGroup>
<Content Include="Assets\Furina\*.png" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
<Content Include="Assets\Furina\furina-app.ico" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
</ItemGroup>
</Project>
