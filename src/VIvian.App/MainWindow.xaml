<Window x:Class="VIvian.App.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
xmlns:local="clr-namespace:VIvian.App" xmlns:core="clr-namespace:VIvian.Core;assembly=VIvian.Core" xmlns:gif="https://github.com/XamlAnimatedGif/XamlAnimatedGif"
Title="{Binding Theme.Title}" Width="1460" Height="900" MinWidth="1180" MinHeight="720" Background="#DCE6FB" Foreground="{StaticResource Text}" FontFamily="Microsoft YaHei UI" FontSize="14" WindowStartupLocation="CenterScreen" UseLayoutRounding="True" TextOptions.TextFormattingMode="Display">
<Window.Resources>
<Style TargetType="TextBlock"><Setter Property="Foreground" Value="{StaticResource Text}"/><Setter Property="TextWrapping" Value="Wrap"/><Setter Property="LineHeight" Value="22"/></Style>
<Style x:Key="H1" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}"><Setter Property="FontSize" Value="28"/><Setter Property="FontWeight" Value="Bold"/><Setter Property="Foreground" Value="{StaticResource Navy}"/><Setter Property="LineHeight" Value="36"/></Style>
<Style x:Key="Kana" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}"><Setter Property="Foreground" Value="{StaticResource Sakura}"/><Setter Property="FontSize" Value="15"/><Setter Property="FontFamily" Value="{StaticResource JapaneseFont}"/><Setter Property="Margin" Value="14,0,0,5"/><Setter Property="VerticalAlignment" Value="Bottom"/></Style>
<Style x:Key="H2" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}"><Setter Property="FontSize" Value="17"/><Setter Property="FontWeight" Value="Bold"/><Setter Property="Foreground" Value="{StaticResource Navy}"/><Setter Property="Margin" Value="0,0,0,6"/></Style>
<Style x:Key="Lead" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}"><Setter Property="Foreground" Value="{StaticResource Muted}"/><Setter Property="Margin" Value="0,6,0,20"/><Setter Property="MaxWidth" Value="780"/><Setter Property="HorizontalAlignment" Value="Left"/></Style>
<Style x:Key="Small" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}"><Setter Property="Foreground" Value="{StaticResource Muted}"/><Setter Property="FontSize" Value="13"/><Setter Property="LineHeight" Value="20"/></Style>
<Style x:Key="Panel" TargetType="Border"><Setter Property="Background" Value="{StaticResource Surface}"/><Setter Property="BorderBrush" Value="{StaticResource Line}"/><Setter Property="BorderThickness" Value="1"/><Setter Property="CornerRadius" Value="18"/><Setter Property="Padding" Value="20"/><Setter Property="Margin" Value="0,0,0,14"/></Style>
<Style x:Key="AccountChoiceList" TargetType="ListBox">
<Setter Property="MinHeight" Value="140"/><Setter Property="MaxHeight" Value="360"/>
<Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="BorderThickness" Value="0"/>
<Setter Property="Background" Value="Transparent"/><Setter Property="Margin" Value="0,10,0,0"/>
<Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled"/>
</Style>
<Style x:Key="AccountChoiceCard" TargetType="Border">
<Setter Property="Background" Value="#EAF0FF"/><Setter Property="BorderBrush" Value="{StaticResource Line}"/>
<Setter Property="BorderThickness" Value="1"/><Setter Property="CornerRadius" Value="12"/>
<Setter Property="Padding" Value="12"/><Setter Property="Margin" Value="0,0,0,8"/>
</Style>
<Style x:Key="Notice" TargetType="Border"><Setter Property="Background" Value="{StaticResource WarnBack}"/><Setter Property="CornerRadius" Value="12"/><Setter Property="Padding" Value="16,12"/><Setter Property="Margin" Value="0,0,0,14"/></Style>
<Style x:Key="Page" TargetType="ScrollViewer"><Setter Property="VerticalScrollBarVisibility" Value="Auto"/><Setter Property="Padding" Value="34,26,34,20"/></Style>
<Style TargetType="Hyperlink"><Setter Property="Foreground" Value="{StaticResource Sakura}"/></Style>
<!-- Navy ribbon heading with gold trim, as in the reference design. -->
<Style x:Key="Ribbon" TargetType="Border"><Setter Property="Background" Value="{StaticResource NavyRibbon}"/><Setter Property="BorderBrush" Value="{StaticResource Gold}"/><Setter Property="BorderThickness" Value="1.5"/><Setter Property="CornerRadius" Value="14,4,14,4"/><Setter Property="Padding" Value="14,6,22,6"/><Setter Property="HorizontalAlignment" Value="Left"/><Setter Property="Margin" Value="0,0,0,12"/></Style>
<Style x:Key="RibbonText" TargetType="TextBlock"><Setter Property="Foreground" Value="White"/><Setter Property="FontSize" Value="16"/><Setter Property="FontWeight" Value="Bold"/></Style>
<Style x:Key="Icon" TargetType="TextBlock"><Setter Property="FontFamily" Value="Segoe Fluent Icons, Segoe MDL2 Assets"/><Setter Property="VerticalAlignment" Value="Center"/></Style>
<!-- Art slot: GIF animates, other images are static, no file shows the vector guide. -->
<DataTemplate x:Key="Art"><Grid>
<Image gif:AnimationBehavior.SourceUri="{Binding Uri}" Visibility="{Binding GifVisibility}" Stretch="Uniform"/>
<Image Source="{Binding Uri}" Visibility="{Binding StaticVisibility}" Stretch="Uniform"/>
<local:Mascot Visibility="{Binding FallbackVisibility}"/></Grid></DataTemplate>
<DataTemplate x:Key="AvatarFill"><Grid>
<Image gif:AnimationBehavior.SourceUri="{Binding Uri}" Visibility="{Binding GifVisibility}" Stretch="UniformToFill" VerticalAlignment="Top"/>
<Image Source="{Binding Uri}" Visibility="{Binding StaticVisibility}" Stretch="UniformToFill" VerticalAlignment="Top"/>
<local:Mascot Visibility="{Binding FallbackVisibility}" Margin="4"/></Grid></DataTemplate>

<!-- Left rail navigation item: Tag holds the icon glyph. -->
<Style x:Key="RailTab" TargetType="TabItem">
<Setter Property="FocusVisualStyle" Value="{x:Null}"/><Setter Property="Cursor" Value="Hand"/>
<Setter Property="Template"><Setter.Value><ControlTemplate TargetType="TabItem">
<Border x:Name="Row" Background="Transparent" CornerRadius="14" Padding="16,11" Margin="10,3" BorderThickness="1.5" BorderBrush="Transparent">
<StackPanel Orientation="Horizontal">
<TextBlock x:Name="Glyph" Text="{TemplateBinding Tag}" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="18" Foreground="{StaticResource OnNavy}" VerticalAlignment="Center" Margin="0,0,14,0"/>
<TextBlock x:Name="Label" Text="{TemplateBinding Header}" Foreground="{StaticResource OnNavy}" FontSize="15" VerticalAlignment="Center"/></StackPanel></Border>
<ControlTemplate.Triggers>
<Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Row" Property="BorderBrush" Value="#5A75C8"/></Trigger>
<Trigger Property="IsSelected" Value="True"><Setter TargetName="Row" Property="Background" Value="#DDE6FF"/><Setter TargetName="Row" Property="BorderBrush" Value="{StaticResource Gold}"/>
<Setter TargetName="Label" Property="Foreground" Value="{StaticResource Text}"/><Setter TargetName="Label" Property="FontWeight" Value="Bold"/><Setter TargetName="Glyph" Property="Foreground" Value="{StaticResource Sakura}"/></Trigger>
<Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Row" Property="BorderBrush" Value="White"/></Trigger>
</ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
<!-- Pill tabs inside a page (game management). -->
<Style x:Key="PillTab" TargetType="TabItem">
<Setter Property="FocusVisualStyle" Value="{x:Null}"/><Setter Property="Cursor" Value="Hand"/>
<Setter Property="Template"><Setter.Value><ControlTemplate TargetType="TabItem">
<Border x:Name="Pill" Background="{StaticResource Surface}" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="18" Padding="18,8" Margin="0,0,10,0">
<TextBlock x:Name="Label" Text="{TemplateBinding Header}" Foreground="{StaticResource Text}" FontWeight="SemiBold"/></Border>
<ControlTemplate.Triggers><Trigger Property="IsSelected" Value="True"><Setter TargetName="Pill" Property="Background" Value="{StaticResource Navy}"/><Setter TargetName="Pill" Property="BorderBrush" Value="{StaticResource Gold}"/><Setter TargetName="Label" Property="Foreground" Value="White"/></Trigger></ControlTemplate.Triggers>
</ControlTemplate></Setter.Value></Setter></Style>
<DataTemplate x:Key="AccountConfigurationGroup">
<TextBlock Text="{Binding Name, StringFormat=✦ {0}}" FontSize="16" FontFamily="{StaticResource Round}" Foreground="{StaticResource Sakura}" Margin="0,20,0,6"/>
</DataTemplate>
<DataTemplate x:Key="AccountConfigurationField">
<Border BorderBrush="{StaticResource Line}" BorderThickness="0,0,0,1" Padding="0,10,0,12"><Grid>
<Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="210"/></Grid.ColumnDefinitions>
<StackPanel Margin="0,0,18,0" ToolTip="{Binding Dependencies}">
<TextBlock Text="{Binding Title}" FontWeight="SemiBold"/>
<TextBlock Text="{Binding Description}" Style="{StaticResource Small}" Margin="0,2,0,0"/>
<TextBlock Text="{Binding State}" Foreground="{StaticResource Warn}" FontSize="12" Margin="0,4,0,0" Visibility="{Binding IsReadOnlyDisplay, Converter={StaticResource Visible}}"/></StackPanel>
<Grid Grid.Column="1" VerticalAlignment="Center">
<CheckBox Style="{StaticResource Switch}" IsChecked="{Binding BoolValue}" IsEnabled="{Binding Editable}" HorizontalAlignment="Right" Visibility="{Binding IsBoolean, Converter={StaticResource Visible}}" AutomationProperties.Name="{Binding Title}"/>
<ComboBox ItemsSource="{Binding Options}" DisplayMemberPath="Label" SelectedValuePath="Value" SelectedValue="{Binding Current}" IsEnabled="{Binding Editable}" Visibility="{Binding IsChoice, Converter={StaticResource Visible}}" AutomationProperties.Name="{Binding Title}"/>
<TextBox Text="{Binding Current, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding Editable}" ToolTip="{Binding Rule}" Visibility="{Binding IsTextual, Converter={StaticResource Visible}}" AutomationProperties.Name="{Binding Title}"/>
<TextBlock Text="由原软件管理" Style="{StaticResource Small}" HorizontalAlignment="Right" Visibility="{Binding IsReadOnlyDisplay, Converter={StaticResource Visible}}"/></Grid>
</Grid></Border></DataTemplate>
</Window.Resources>

<Grid>
<!-- Background: soft royal-blue sky with bubbles and a wave (decorative; panels keep solid colours). -->
<Rectangle IsHitTestVisible="False"><Rectangle.Fill><LinearGradientBrush StartPoint="0,0" EndPoint="0.4,1"><GradientStop Color="#EEF3FF" Offset="0"/><GradientStop Color="#D3E0FB" Offset="0.55"/><GradientStop Color="#B9CCF5" Offset="1"/></LinearGradientBrush></Rectangle.Fill></Rectangle>
<Image Source="{Binding Theme.Background}" Stretch="UniformToFill" Opacity="0.45" IsHitTestVisible="False"/>
<Ellipse IsHitTestVisible="False" Width="640" Height="640" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,-300,-180,0"><Ellipse.Fill><RadialGradientBrush><GradientStop Color="#80FFFFFF" Offset="0"/><GradientStop Color="#00FFFFFF" Offset="1"/></RadialGradientBrush></Ellipse.Fill></Ellipse>
<Path IsHitTestVisible="False" VerticalAlignment="Bottom" Stretch="Fill" Height="120" Data="M 0,60 C 200,0 400,120 600,60 C 800,0 1000,120 1200,60 L 1200,120 L 0,120 Z"><Path.Fill><LinearGradientBrush StartPoint="0,0" EndPoint="0,1"><GradientStop Color="#663D6BEA" Offset="0"/><GradientStop Color="#AA2341A8" Offset="1"/></LinearGradientBrush></Path.Fill></Path>
<Canvas IsHitTestVisible="False">
<Ellipse Canvas.Left="300" Canvas.Top="180" Width="26" Height="26" Stroke="#99FFFFFF" StrokeThickness="1.5"><Ellipse.Fill><RadialGradientBrush GradientOrigin="0.3,0.3"><GradientStop Color="#CCFFFFFF" Offset="0"/><GradientStop Color="#225F86E8" Offset="1"/></RadialGradientBrush></Ellipse.Fill></Ellipse>
<Ellipse Canvas.Left="1240" Canvas.Top="96" Width="40" Height="40" Stroke="#99FFFFFF" StrokeThickness="1.5"><Ellipse.Fill><RadialGradientBrush GradientOrigin="0.3,0.3"><GradientStop Color="#CCFFFFFF" Offset="0"/><GradientStop Color="#225F86E8" Offset="1"/></RadialGradientBrush></Ellipse.Fill></Ellipse>
<Ellipse Canvas.Left="560" Canvas.Top="760" Width="18" Height="18" Stroke="#99FFFFFF" StrokeThickness="1.2"><Ellipse.Fill><RadialGradientBrush GradientOrigin="0.3,0.3"><GradientStop Color="#CCFFFFFF" Offset="0"/><GradientStop Color="#225F86E8" Offset="1"/></RadialGradientBrush></Ellipse.Fill></Ellipse>
</Canvas>

<Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
<!-- Title -->
<StackPanel Orientation="Horizontal" Margin="26,14,0,8">
<Path Width="46" Height="34" Stretch="Uniform" VerticalAlignment="Center" Data="M 2,30 L 6,8 L 16,20 L 24,2 L 32,20 L 42,8 L 46,30 Z M 4,33 L 44,33 L 44,37 L 4,37 Z" Fill="{StaticResource Gold}" Stroke="#8C6A24" StrokeThickness="1"/>
<StackPanel Margin="14,0,0,0" VerticalAlignment="Center">
<TextBlock Text="{Binding Theme.Title}" FontFamily="{StaticResource Script}" FontStyle="Italic" FontSize="32" Foreground="{StaticResource Navy}" LineHeight="36"/>
<TextBlock Text="游戏自动化代理工具 · 一键完成多游戏日常" Foreground="{StaticResource Muted}" FontSize="13"/></StackPanel></StackPanel>

<TabControl x:Name="Navigation" Grid.Row="1" TabStripPlacement="Left" Background="Transparent" BorderThickness="0" Padding="0" ItemContainerStyle="{StaticResource RailTab}">
<TabControl.Template><ControlTemplate TargetType="TabControl">
<Grid><Grid.ColumnDefinitions><ColumnDefinition Width="214"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
<Border Background="{StaticResource Rail}" CornerRadius="0,22,22,0" Margin="0,4,0,8" Padding="0,14,0,14"><DockPanel>
<Border DockPanel.Dock="Bottom" Margin="14,12,14,4" Padding="12,10" CornerRadius="12" Background="#2E4AA8" BorderBrush="{StaticResource Gold}" BorderThickness="1">
<TextBlock Text="{Binding ExecutionBanner}" Foreground="White" FontSize="12" LineHeight="18" TextWrapping="Wrap"/></Border>
<TabPanel IsItemsHost="True" Background="Transparent" KeyboardNavigation.TabIndex="1"/></DockPanel></Border>
<ContentPresenter Grid.Column="1" ContentSource="SelectedContent"/></Grid>
</ControlTemplate></TabControl.Template>

<!-- ============ 首页概览 ============ -->
<TabItem Header="首页概览" Tag="&#xE80F;"><Grid Margin="0,0,16,0">
<Grid.ColumnDefinitions><ColumnDefinition Width="320"/><ColumnDefinition Width="*"/><ColumnDefinition Width="292"/></Grid.ColumnDefinitions>
<Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
<!-- Character: click to open the assistant -->
<Button Grid.RowSpan="2" Click="OpenAssistant" IsEnabled="{Binding CanOperateWorkspace}" Cursor="Hand" ToolTip="{Binding Assistant.Name, StringFormat=点我打开 AI 助手 · {0}}" AutomationProperties.Name="打开 AI 助手" VerticalAlignment="Bottom" Margin="6,0,0,0">
<Button.Template><ControlTemplate TargetType="Button"><ContentPresenter/></ControlTemplate></Button.Template>
<ContentPresenter Content="{Binding CharacterArt}" ContentTemplate="{StaticResource Art}" MaxHeight="700" Margin="-10,0,-20,0"/></Button>

<ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto" Padding="4,6,10,10"><StackPanel>
<!-- Blocked by an unconfirmed cleanup: say so where the user is, with the way out. -->
<Border Background="{StaticResource DangerBack}" BorderBrush="{StaticResource Danger}" BorderThickness="1.5" CornerRadius="16" Padding="18,14" Margin="0,0,0,14">
<Border.Style><Style TargetType="Border"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding Queue.HasUnresolved}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></Border.Style>
<StackPanel><TextBlock Text="新任务暂时等待：正在核实上一次运行已经结束" Foreground="{StaticResource DangerText}" FontWeight="Bold" FontSize="15"/>
<TextBlock Text="{Binding Queue.HomeCleanupHint}" Foreground="{StaticResource DangerText}" Margin="0,6,0,4"/>
<TextBlock Text="{Binding Queue.Status}" Foreground="{StaticResource DangerText}" FontWeight="SemiBold" Margin="0,0,0,10"/>
<Button Content="我已确认，全部已关闭" Command="{Binding Queue.AcknowledgeCommand}" IsEnabled="{Binding Queue.CanAcknowledge}" HorizontalAlignment="Left" Background="White"/></StackPanel></Border>
<!-- 今日概览 -->
<Border Style="{StaticResource Panel}" Padding="18,14"><StackPanel>
<StackPanel Orientation="Horizontal"><Border Style="{StaticResource Ribbon}" Margin="0"><StackPanel Orientation="Horizontal"><TextBlock Text="&#xE734;" Style="{StaticResource Icon}" Foreground="{StaticResource GoldText}" FontSize="16" Margin="0,0,10,0"/><TextBlock Text="今日概览" Style="{StaticResource RibbonText}"/></StackPanel></Border>
<TextBlock Text="{Binding TodayText}" Style="{StaticResource Small}" VerticalAlignment="Center" Margin="14,0,0,0"/></StackPanel>
<UniformGrid Columns="4" Margin="0,14,0,0">
<Border Background="{StaticResource Tile}" CornerRadius="14" Padding="14,10" Margin="0,0,8,0" ToolTip="已开放完整日常的游戏数量"><StackPanel Orientation="Horizontal"><TextBlock Text="&#xE73E;" Style="{StaticResource Icon}" FontSize="22" Foreground="{StaticResource Sakura}" Margin="0,0,10,0"/><StackPanel><TextBlock Text="完整日常" Style="{StaticResource Small}"/><TextBlock Text="{Binding RunnableText}" FontSize="20" FontWeight="Bold"/></StackPanel></StackPanel></Border>
<Border Background="{StaticResource Tile}" CornerRadius="14" Padding="14,10" Margin="0,0,8,0"><StackPanel Orientation="Horizontal"><TextBlock Text="&#xE787;" Style="{StaticResource Icon}" FontSize="22" Foreground="{StaticResource Sakura}" Margin="0,0,10,0"/><StackPanel><TextBlock Text="已勾选账号" Style="{StaticResource Small}"/><TextBlock Text="{Binding SelectedAccountsText}" FontSize="20" FontWeight="Bold"/></StackPanel></StackPanel></Border>
<Border Background="{StaticResource Tile}" CornerRadius="14" Padding="14,10" Margin="0,0,8,0"><StackPanel Orientation="Horizontal"><TextBlock Text="&#xE916;" Style="{StaticResource Icon}" FontSize="22" Foreground="{StaticResource Sakura}" Margin="0,0,10,0"/><StackPanel><TextBlock Text="预计耗时" Style="{StaticResource Small}"/><TextBlock Text="{Binding EstimateText}" FontSize="20" FontWeight="Bold"/></StackPanel></StackPanel></Border>
<Border Background="{StaticResource Tile}" CornerRadius="14" Padding="14,10"><StackPanel Orientation="Horizontal"><TextBlock Text="&#xE9D9;" Style="{StaticResource Icon}" FontSize="22" Foreground="{StaticResource Sakura}" Margin="0,0,10,0"/><StackPanel><TextBlock Text="运行状态" Style="{StaticResource Small}"/><TextBlock Text="{Binding RunStateText}" FontSize="20" FontWeight="Bold" Foreground="{StaticResource Ok}"/></StackPanel></StackPanel></Border>
</UniformGrid></StackPanel></Border>

<!-- 游戏与日常任务 -->
<Border Style="{StaticResource Panel}" Padding="18,14"><StackPanel>
<Border Style="{StaticResource Ribbon}"><StackPanel Orientation="Horizontal"><TextBlock Text="&#xE7FC;" Style="{StaticResource Icon}" Foreground="{StaticResource GoldText}" FontSize="16" Margin="0,0,10,0"/><TextBlock Text="游戏与日常任务" Style="{StaticResource RibbonText}"/></StackPanel></Border>
<ItemsControl ItemsSource="{Binding Engines}"><ItemsControl.ItemTemplate><DataTemplate>
<Border Background="White" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="14" Margin="0,0,0,10" ClipToBounds="True"><Grid>
<Grid.ColumnDefinitions><ColumnDefinition Width="200"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
<!-- Banner: user image if supplied, otherwise a game-coloured plate with the title -->
<Border CornerRadius="13,0,0,13" MinHeight="78">
<Border.Background><LinearGradientBrush StartPoint="0,0" EndPoint="1,1"><GradientStop Color="{Binding BannerFrom}" Offset="0"/><GradientStop Color="{Binding BannerTo}" Offset="1"/></LinearGradientBrush></Border.Background>
<Grid><Image Source="{Binding Banner.Uri}" Stretch="UniformToFill" Visibility="{Binding Banner.StaticVisibility}"/>
<Image gif:AnimationBehavior.SourceUri="{Binding Banner.Uri}" Stretch="UniformToFill" Visibility="{Binding Banner.GifVisibility}"/>
<StackPanel Margin="18,0,0,0" VerticalAlignment="Center" Visibility="{Binding Banner.FallbackVisibility}">
<TextBlock Text="{Binding Name}" Foreground="White" FontSize="22" FontWeight="Bold" TextWrapping="NoWrap"/>
<TextBlock Text="{Binding Tagline}" Foreground="#E6ECFF" FontFamily="{StaticResource Script}" FontStyle="Italic" FontSize="13" TextWrapping="NoWrap"/></StackPanel></Grid></Border>
<StackPanel Grid.Column="1" Margin="16,10,8,10" VerticalAlignment="Center">
<DockPanel><Ellipse Width="9" Height="9" Fill="{Binding StateBrush}" Margin="0,0,8,0" VerticalAlignment="Center"/>
<TextBlock DockPanel.Dock="Right" Text="{Binding RunHint}" Style="{StaticResource Small}" FontSize="12" TextWrapping="NoWrap" Margin="8,0,0,0"/>
<TextBlock Text="{Binding ShortVersion}" FontWeight="SemiBold" FontSize="13" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" ToolTip="{Binding Version}"/></DockPanel>
<ItemsControl ItemsSource="{Binding Chips}" Margin="0,8,0,0"><ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
<ItemsControl.ItemTemplate><DataTemplate><Border Background="{StaticResource Tile}" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="8" Padding="10,2" Margin="0,0,6,4"><TextBlock Text="{Binding}" FontSize="12"/></Border></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></StackPanel>
<StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,14,0">
<Button Content="&#xE713;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" Click="OpenGameSettings" Tag="{Binding Id}" ToolTip="配置" Padding="10,8" Margin="0,0,8,0" AutomationProperties.Name="{Binding Name, StringFormat={}{0} 配置}"/>
<Button Style="{StaticResource Primary}" Content="&#xE768;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" Command="{Binding DataContext.PlayGameCardCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding Id}" IsEnabled="{Binding CanPlayFromHome}" ToolTip="{Binding HomePlayHint}" Padding="12,9" Margin="0" AutomationProperties.Name="{Binding Name, StringFormat=运行 {0}}"/>
</StackPanel></Grid></Border></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></StackPanel></Border>

<!-- 最近运行 + 本次运行 -->
<Grid><Grid.ColumnDefinitions><ColumnDefinition Width="3*"/><ColumnDefinition Width="2*"/></Grid.ColumnDefinitions>
<Border Style="{StaticResource Panel}" Padding="18,14" Margin="0,0,10,14"><StackPanel>
<Border Style="{StaticResource Ribbon}"><StackPanel Orientation="Horizontal"><TextBlock Text="&#xE81C;" Style="{StaticResource Icon}" Foreground="{StaticResource GoldText}" FontSize="16" Margin="0,0,10,0"/><TextBlock Text="最近运行" Style="{StaticResource RibbonText}"/></StackPanel></Border>
<TextBlock Text="还没有真实运行记录。"><TextBlock.Style><Style TargetType="TextBlock" BasedOn="{StaticResource Small}"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding RecentRuns.Count}" Value="0"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock>
<ItemsControl ItemsSource="{Binding RecentRuns}"><ItemsControl.ItemTemplate><DataTemplate>
<Grid Margin="0,0,0,8"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
<TextBlock FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="16" VerticalAlignment="Center" Margin="0,0,10,0"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Text" Value="&#xE783;"/><Setter Property="Foreground" Value="{StaticResource Warn}"/><Style.Triggers><DataTrigger Binding="{Binding Succeeded}" Value="True"><Setter Property="Text" Value="&#xE930;"/><Setter Property="Foreground" Value="{StaticResource Ok}"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock>
<StackPanel Grid.Column="1"><TextBlock Text="{Binding Game}" FontWeight="SemiBold" FontSize="13"/><TextBlock Text="{Binding Result}" Style="{StaticResource Small}" FontSize="12"/></StackPanel>
<StackPanel Grid.Column="2" Margin="8,0,0,0"><TextBlock Text="{Binding When}" Style="{StaticResource Small}" FontSize="12" HorizontalAlignment="Right"/><TextBlock Text="{Binding Duration}" Style="{StaticResource Small}" FontSize="12" HorizontalAlignment="Right"/></StackPanel>
</Grid></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></StackPanel></Border>
<Border Grid.Column="1" Style="{StaticResource Panel}" Padding="18,14"><StackPanel>
<Border Style="{StaticResource Ribbon}"><StackPanel Orientation="Horizontal"><TextBlock Text="&#xE9D2;" Style="{StaticResource Icon}" Foreground="{StaticResource GoldText}" FontSize="16" Margin="0,0,10,0"/><TextBlock Text="本次运行" Style="{StaticResource RibbonText}"/></StackPanel></Border>
<TextBlock Text="{Binding Queue.Current}" FontSize="13"/>
<TextBlock Text="{Binding Queue.Status}" Style="{StaticResource Small}" Margin="0,4,0,0"/>
<TextBlock Text="{Binding BatchStatus}" Style="{StaticResource Small}" Margin="0,4,0,0" AutomationProperties.LiveSetting="Polite"/>
</StackPanel></Border></Grid>
</StackPanel></ScrollViewer>

<!-- Right column: automation control + system status -->
<ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto" Padding="0,6,0,10"><StackPanel>
<Border Style="{StaticResource Panel}" Padding="18,14"><StackPanel>
<Border Style="{StaticResource Ribbon}"><StackPanel Orientation="Horizontal"><TextBlock Text="&#xE945;" Style="{StaticResource Icon}" Foreground="{StaticResource GoldText}" FontSize="16" Margin="0,0,10,0"/><TextBlock Text="自动化控制" Style="{StaticResource RibbonText}"/></StackPanel></Border>
<Button Command="{Binding OneClickCommand}" IsEnabled="{Binding CanOperateWorkspace}" HorizontalAlignment="Center" Margin="0,8,0,14" Cursor="Hand" AutomationProperties.Name="一键日常">
<Button.Template><ControlTemplate TargetType="Button"><Grid Width="176" Height="176">
<Ellipse Stroke="{StaticResource Gold}" StrokeThickness="3" Fill="#DDE6FF"/>
<Border x:Name="Core" Margin="12" CornerRadius="76" Background="{StaticResource Dream}" BorderBrush="White" BorderThickness="2">
<StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
<Path Data="M 0,0 L 26,15 L 0,30 Z" Fill="White" HorizontalAlignment="Center" Margin="6,0,0,6"/>
<TextBlock Text="一键日常" Foreground="White" FontSize="22" FontWeight="Bold"/></StackPanel></Border></Grid>
<ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Core" Property="Opacity" Value="0.9"/></Trigger>
<Trigger Property="IsPressed" Value="True"><Setter TargetName="Core" Property="Opacity" Value="0.8"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Button.Template></Button>
<UniformGrid Columns="2">
<Button Content="{Binding Queue.PauseButtonText}" Command="{Binding Queue.PauseCommand}" IsEnabled="{Binding Queue.CanPause}" Margin="0,0,6,0" Padding="6,9" FontSize="13"/>
<Button Style="{StaticResource DangerButton}" Content="停止" Command="{Binding StopAllCommand}" IsEnabled="{Binding CanStopAll}" Margin="0" Padding="6,9" FontSize="13"/></UniformGrid>
<TextBlock Text="{Binding DailyStartHint}" Style="{StaticResource Small}" FontSize="12" Margin="0,10,0,0" TextWrapping="Wrap"/>
<Button Content="核对桌面交接" Command="{Binding RecoverDesktopCommand}" IsEnabled="{Binding IsIdle}" HorizontalAlignment="Left" Margin="0,6,0,0"/>
