<Window x:Class="VIvian.App.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:VIvian.App"
Title="VIvian · 三游戏日常控制中心" Width="1120" Height="780" MinWidth="640" MinHeight="480" Background="#0D1523" Foreground="#EEF3FB" FontFamily="Microsoft YaHei UI" FontSize="14" WindowStartupLocation="CenterScreen" UseLayoutRounding="True">
<Window.Resources>
<!-- Window-level implicit styles stop at template boundaries, so controls keep their own readable text colours. -->
<Style TargetType="TextBlock"><Setter Property="Foreground" Value="#EEF3FB"/><Setter Property="TextWrapping" Value="Wrap"/></Style>
<Style x:Key="Card" TargetType="Border"><Setter Property="Background" Value="{StaticResource Surface}"/><Setter Property="CornerRadius" Value="12"/><Setter Property="Padding" Value="20"/><Setter Property="Margin" Value="0,0,0,12"/></Style>
<Style x:Key="Notice" TargetType="Border"><Setter Property="Background" Value="#3A2A12"/><Setter Property="CornerRadius" Value="12"/><Setter Property="Padding" Value="16"/><Setter Property="Margin" Value="0,0,0,16"/></Style>
</Window.Resources>
<Grid Margin="28">
<Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
<Grid Margin="0,0,0,24"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
<StackPanel><TextBlock Text="VIvian" FontSize="32" FontWeight="Bold"/><TextBlock Text="每天的旅程，从这里开始。" Foreground="{StaticResource Muted}" Margin="0,6,0,0"/></StackPanel>
<Border Grid.Column="1" Background="#3A2A12" CornerRadius="14" Padding="14,8" VerticalAlignment="Center"><TextBlock Text="{Binding ExecutionBanner}" Foreground="#F2CC85"/></Border>
</Grid>
<TabControl Grid.Row="1" Background="#0D1523" BorderThickness="0" Padding="0,20,0,0">

<TabItem Header="概览"><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel>
<Border Style="{StaticResource Card}" Visibility="{Binding M5Visibility}"><StackPanel>
<TextBlock Text="星铁 · 每日实训" FontSize="22" FontWeight="SemiBold"/>
<TextBlock Text="{Binding VersionText}" Foreground="#93B3FF" Margin="0,5,0,8"/>
<TextBlock Text="{Binding DiagnosticSessionText}" Foreground="{StaticResource Muted}" Margin="0,0,0,8"/>
<TextBlock Text="{Binding ManualTestStateText}" FontWeight="SemiBold" Foreground="#F2CC85" AutomationProperties.LiveSetting="Polite"/>
<TextBlock Text="{Binding Configuration.Status, StringFormat=配置同步：{0}}" Foreground="{StaticResource Muted}" Margin="0,5,0,0"/>
<TextBlock Text="{Binding LastRealResultText}" Foreground="{StaticResource Muted}" Margin="0,5,0,8"/>
<CheckBox IsChecked="{Binding March7thConfirmedThisRun}" Content="我确认本次真实游戏测试（仅 daily）" AutomationProperties.Name="确认本次星铁 daily"/>
<CheckBox IsChecked="{Binding AllowTemporaryConfigurationThisRun}" Content="{Binding TemporaryConfigurationText}" Visibility="{Binding TemporaryConfigurationVisibility}" Margin="0,6,0,0" AutomationProperties.Name="允许本次临时修改上游设置"/>
<StackPanel Visibility="{Binding PendingRestoreVisibility}" Margin="0,6,0,0"><TextBlock Text="{Binding PendingRestoreText}" Foreground="#F2CC85"/>
<Button Content="恢复临时配置" Command="{Binding RestoreConfigurationCommand}" HorizontalAlignment="Left" Margin="0,6,0,0" AutomationProperties.Name="恢复临时配置"/></StackPanel>
<WrapPanel Margin="0,10,0,0"><Button Content="开始本次真实测试" Command="{Binding StartMarch7thCommand}" IsEnabled="{Binding CanStartMarch7th}" Margin="0,0,8,0"/>
<Button Content="停止当前任务" Command="{Binding Queue.StopCommand}" IsEnabled="{Binding Queue.IsRunning}" Margin="0,0,8,0"/>
<Button Content="保存反馈" Command="{Binding SaveFeedbackCommand}"/></WrapPanel>
<TextBlock Text="需要 UAC 时请由本人决定；启动 VIvian 不会自动运行游戏。" Foreground="{StaticResource Muted}" Margin="0,8,0,0"/>
</StackPanel></Border>
<Border Style="{StaticResource Card}" Padding="24" Margin="0,0,0,16"><StackPanel>
<TextBlock Text="准备好你的三段旅程" FontSize="24" FontWeight="SemiBold"/>
<TextBlock Text="VIvian 会在启动时自动发现已安装的引擎并核对固定版本。缺少引擎会显示未检测到，不妨碍其他功能。真实任务仅在明确确认后执行。" Foreground="{StaticResource Muted}" Margin="0,10,0,22"/>
<WrapPanel IsEnabled="{Binding IsIdle}"><Button Content="检查全部引擎（只读）" Command="{Binding CheckEnginesCommand}" Margin="0,0,10,8"/><Button Content="运行基础自检" Command="{Binding CheckCommand}" Margin="0,0,10,8"/><TextBlock Text="只读取文件信息，不启动任何程序或游戏" VerticalAlignment="Center" Foreground="{StaticResource Muted}"/></WrapPanel>
</StackPanel></Border>
<Border Style="{StaticResource Notice}"><StackPanel>
<TextBlock Text="模拟与真实的区别" FontWeight="SemiBold" Foreground="#F2CC85"/>
<TextBlock Text="标注【模拟】的运行来自内置模拟引擎，不代表任何游戏的真实日常。“待桌面验证”表示安装文件看起来正确，但启动方式、进程归属和完成信号都还没有实测，因此不会执行。" Foreground="#E8D9BC" Margin="0,6,0,0"/>
</StackPanel></Border>
<ItemsControl ItemsSource="{Binding Engines}"><ItemsControl.ItemTemplate><DataTemplate>
<Border Style="{StaticResource Card}"><Grid>
<Grid.ColumnDefinitions><ColumnDefinition Width="48"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
<TextBlock Text="{Binding Glyph}" FontSize="24" Foreground="#93B3FF" VerticalAlignment="Top"/>
<StackPanel Grid.Column="1">
<TextBlock Text="{Binding Name}" FontSize="19" FontWeight="SemiBold"/>
<TextBlock Text="{Binding Engine}" Foreground="{StaticResource Muted}" Margin="0,5,0,0"/>
<TextBlock Text="{Binding PinnedVersion}" Foreground="{StaticResource Muted}" Margin="0,5,12,0"/>
<TextBlock Text="{Binding DetectedVersion}" Foreground="{StaticResource Muted}" Margin="0,5,12,0"/>
<TextBlock Text="{Binding Evidence}" Foreground="{StaticResource Muted}" Margin="0,5,12,0"/>
<TextBlock Text="{Binding PendingWarning}" Foreground="#F2CC85" Margin="0,5,12,0"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="TextWrapping" Value="Wrap"/><Style.Triggers><Trigger Property="Text" Value=""><Setter Property="Visibility" Value="Collapsed"/></Trigger></Style.Triggers></Style></TextBlock.Style></TextBlock>
<TextBlock Text="{Binding LastRun}" Foreground="{StaticResource Muted}" Margin="0,5,12,0"/>
<TextBlock Text="{Binding Execution}" Foreground="#F2CC85" Margin="0,5,12,0"/>
</StackPanel>
<TextBlock Grid.Column="2" Text="{Binding Compatibility}" Foreground="{Binding StateBrush}" FontWeight="SemiBold" VerticalAlignment="Top" MaxWidth="220" Margin="12,0,0,0" AutomationProperties.Name="引擎状态"/>
</Grid></Border></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
</StackPanel></ScrollViewer></TabItem>

<TabItem Header="引擎管理"><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel IsEnabled="{Binding IsIdle}">
<TextBlock Text="引擎位置与检查" FontSize="24" FontWeight="SemiBold"/>
<TextBlock Text="填写已经安装的目录；留空也可以。保存后 VIvian 只读检查：不创建目录、不修改引擎文件、不读取上游配置内容、不运行程序。" Foreground="{StaticResource Muted}" Margin="0,10,0,20"/>
<ItemsControl ItemsSource="{Binding Engines}"><ItemsControl.ItemTemplate><DataTemplate><Border Style="{StaticResource Card}"><StackPanel>
<Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
<TextBlock Text="{Binding Name}" FontSize="18"/><TextBlock Grid.Column="1" Text="{Binding Compatibility}" Foreground="{Binding StateBrush}" FontWeight="SemiBold"/></Grid>
<TextBlock Text="{Binding PinnedVersion}" Foreground="{StaticResource Muted}" Margin="0,4,0,10"/>
<DockPanel><Button DockPanel.Dock="Right" Content="浏览…" Click="BrowseEngineFolder" Tag="{Binding}" Margin="8,0,0,0"/>
<TextBox Text="{Binding InstallPath, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="{Binding Name}" ToolTip="引擎安装目录"/></DockPanel>
<TextBlock Text="{Binding DetectedVersion}" Foreground="{StaticResource Muted}" Margin="0,10,0,0"/>
<Expander Margin="0,10,0,0" Foreground="#EEF3FB"><Expander.Header><Border Background="#24324A" CornerRadius="6" Padding="8,4"><TextBlock Text="检查详情" Foreground="#EEF3FB"/></Border></Expander.Header><ItemsControl ItemsSource="{Binding Checks}" Margin="0,8,0,0"><ItemsControl.ItemTemplate><DataTemplate>
<Grid Margin="0,0,0,8"><Grid.ColumnDefinitions><ColumnDefinition Width="90"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
<TextBlock Text="{Binding State}" Foreground="{Binding Brush}" FontWeight="SemiBold"/>
<StackPanel Grid.Column="1"><TextBlock Text="{Binding Title}" FontWeight="SemiBold"/><TextBlock Text="{Binding Message}" Foreground="{StaticResource Muted}"/><TextBlock Text="{Binding Action}" Foreground="#93B3FF"/></StackPanel>
</Grid></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></Expander>
<Expander Margin="0,6,0,0" Foreground="#EEF3FB"><Expander.Header><Border Background="#24324A" CornerRadius="6" Padding="8,4"><TextBlock Text="能力与证据" Foreground="#EEF3FB"/></Border></Expander.Header><ItemsControl ItemsSource="{Binding Capabilities}" Margin="0,8,0,0"><ItemsControl.ItemTemplate><DataTemplate>
<Grid Margin="0,0,0,8"><Grid.ColumnDefinitions><ColumnDefinition Width="220"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
<StackPanel><TextBlock Text="{Binding Title}" FontWeight="SemiBold"/><TextBlock Text="{Binding Status}" Foreground="{Binding Brush}"/></StackPanel>
<TextBlock Grid.Column="1" Text="{Binding Note}" Foreground="{StaticResource Muted}" Margin="10,0,0,0"/>
</Grid></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></Expander>
</StackPanel></Border></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
<WrapPanel Margin="0,12,0,0"><Button Content="自动填入已发现目录" Command="{Binding AutoDiscoverCommand}" Margin="0,0,10,8"/><Button Content="保存路径并检查" Command="{Binding SaveCommand}" Margin="0,0,10,8"/><Button Content="重新检查（只读）" Command="{Binding CheckEnginesCommand}" Margin="0,0,10,8"/><Button Content="重新加载（放弃未保存修改）" Command="{Binding ReloadCommand}" Margin="0,0,10,8"/></WrapPanel>
<Border Style="{StaticResource Card}" Margin="0,20,0,0"><StackPanel>
<TextBlock Text="核对星铁官方发行包（验证证据）" FontSize="18" Margin="0,0,0,6"/>
<TextBlock Text="选择从 March7thAssistant 官方 GitHub Release 下载的 March7thAssistant_full.zip（v2026.10.31）。VIvian 计算它的 SHA-256 并与官方公布的摘要比对，再从压缩包内读取 m7a.exe 的摘要，用来核对上面填写的安装目录。不解压、不运行任何文件；核对结果只在本次运行中有效，文件位置会被记住。" Foreground="{StaticResource Muted}" Margin="0,0,0,10"/>
<DockPanel><Button DockPanel.Dock="Right" Content="浏览…" Click="BrowseReleaseArchive" Margin="8,0,0,0"/><TextBox Text="{Binding ReleaseArchivePath, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="官方发行包路径" ToolTip="官方发行包文件路径"/></DockPanel>
<WrapPanel Margin="0,10,0,0"><Button Content="核对官方发行包" Command="{Binding VerifyReleaseCommand}"/></WrapPanel>
<TextBlock Text="{Binding ReleaseStatus}" Foreground="{StaticResource Muted}" Margin="0,8,0,0"/>
</StackPanel></Border>
</StackPanel></ScrollViewer></TabItem>

<TabItem Header="{Binding RealTestTabHeader}"><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel>
<TextBlock Text="{Binding RealTestTitle}" FontSize="24" FontWeight="SemiBold"/>
<Border Style="{StaticResource Card}" Margin="0,14,0,0"><StackPanel>
<TextBlock Text="{Binding ManualTestStateText}" FontSize="18" FontWeight="SemiBold" AutomationProperties.LiveSetting="Polite"/>
<TextBlock Text="{Binding LastRealResultText}" Foreground="{StaticResource Muted}" Margin="0,6,0,0" AutomationProperties.LiveSetting="Polite"/>
</StackPanel></Border>
<Border Style="{StaticResource Notice}" Margin="0,14,0,12"><StackPanel>
<TextBlock Text="执行安全闸门" FontWeight="SemiBold" Foreground="#F2CC85"/>
<TextBlock Text="{Binding March7thExecutionBlock}" Foreground="#E8D9BC" Margin="0,6,0,0" AutomationProperties.LiveSetting="Polite"/>
</StackPanel></Border>
<Border Style="{StaticResource Card}"><StackPanel>
<TextBlock Text="上游安装与固定版本" FontSize="18" FontWeight="SemiBold"/>
<TextBlock Text="支持版本：March7thAssistant v2026.10.31；游戏路径须由上游设置，并在状态查询中核对。" Foreground="{StaticResource Muted}" Margin="0,6,0,10"/>
<TextBlock Text="{Binding Engines[1].InstallPath, StringFormat=安装目录：{0}}" Foreground="{StaticResource Muted}"/>
<TextBlock Text="{Binding Engines[1].Compatibility, StringFormat=安装检查：{0}}" Foreground="{StaticResource Muted}" Margin="0,5,0,0"/>
<TextBlock Text="{Binding ReleaseStatus}" Foreground="{StaticResource Muted}" Margin="0,5,0,0"/>
<TextBlock Text="{Binding March7thStopStatus}" Foreground="#F2CC85" Margin="0,5,0,0"/>
</StackPanel></Border>
<Border Style="{StaticResource Card}"><StackPanel>
<TextBlock Text="任务与本次确认" FontSize="18" FontWeight="SemiBold"/>
<ComboBox ItemsSource="{Binding March7thTasks}" SelectedItem="{Binding March7thTask}" DisplayMemberPath="Title" Width="260" HorizontalAlignment="Left" Margin="0,10,0,10" AutomationProperties.Name="星铁真实任务选择"/>
<CheckBox IsChecked="{Binding March7thConfirmedThisRun}" Content="我了解这会运行真实游戏自动化任务，仅确认本次执行" AutomationProperties.Name="确认本次星铁真实任务"/>
<WrapPanel Margin="0,12,0,0">
<Button Content="{Binding StartButtonText}" Command="{Binding StartMarch7thCommand}" IsEnabled="{Binding CanStartMarch7th}" Margin="0,0,10,0"/>
<Button Content="紧急停止当前任务" Command="{Binding Queue.StopCommand}" IsEnabled="{Binding Queue.IsRunning}" Background="#F08A80"/>
</WrapPanel>
<TextBlock Text="{Binding March7thConsentNote}" Foreground="{StaticResource Muted}" Margin="0,10,0,0"/>
</StackPanel></Border>
<Border Style="{StaticResource Card}"><StackPanel>
<TextBlock Text="运行状态、日志与结果" FontSize="18" FontWeight="SemiBold"/>
<TextBlock Text="{Binding Queue.Current}" Margin="0,8,0,0"/>
<TextBlock Text="{Binding Queue.Status}" Foreground="{StaticResource Muted}" Margin="0,4,0,8"/>
<ListBox ItemsSource="{Binding Queue.LogLines}" Height="180" Background="#101A2A" Foreground="#EEF3FB"/>
<TextBlock Text="执行历史及清理结果详见“调度与监控”。出现问题时：先截图，再点击下面的按钮导出诊断报告。" Foreground="{StaticResource Muted}" Margin="0,8,0,0"/>
<WrapPanel Margin="0,10,0,0" IsEnabled="{Binding IsIdle}"><Button Content="导出诊断报告" Command="{Binding ExportDiagnosticsCommand}" Margin="0,0,10,0"/></WrapPanel>
<TextBlock Text="{Binding ExportStatus}" Foreground="{StaticResource Muted}" Margin="0,6,0,0"/>
</StackPanel></Border>
</StackPanel></ScrollViewer></TabItem>

<TabItem Header="任务管理"><Grid>
<Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
<Border Style="{StaticResource Notice}"><StackPanel>
<TextBlock Text="三游戏任务目录与配置" FontWeight="SemiBold" Foreground="#F2CC85"/>
<TextBlock Text="任务选择会保存为计划。星铁 daily 的真实执行仍需在专用页逐次确认；其他待验证任务不会自动运行。" Foreground="#E8D9BC" Margin="0,6,0,0"/>
</StackPanel></Border>
<DockPanel Grid.Row="1" Margin="0,0,0,12"><TextBlock Text="游戏：" VerticalAlignment="Center" Margin="0,0,8,0"/>
<ComboBox ItemsSource="{Binding TaskPlans}" SelectedItem="{Binding SelectedPlan}" DisplayMemberPath="Name" MinWidth="320" HorizontalAlignment="Left" AutomationProperties.Name="选择游戏"/></DockPanel>
<Grid Grid.Row="2" DataContext="{Binding SelectedPlan}"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
<ListBox ItemsSource="{Binding Rows}" SelectedItem="{Binding Selected}" Background="#101A2A" BorderThickness="0" HorizontalContentAlignment="Stretch" ScrollViewer.HorizontalScrollBarVisibility="Disabled" AutomationProperties.Name="任务列表"><ListBox.ItemTemplate><DataTemplate>
<Grid Margin="6"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
<CheckBox IsChecked="{Binding Enabled}" VerticalAlignment="Center" AutomationProperties.Name="{Binding Title}"/>
<StackPanel Grid.Column="1" Margin="10,0,10,0"><TextBlock Text="{Binding Title}" FontSize="15" Foreground="#EEF3FB"/><TextBlock Text="{Binding Note}" Foreground="#B6C3D5" FontSize="12"/></StackPanel>
<TextBlock Grid.Column="2" Text="{Binding Status}" Foreground="#E5BF76" VerticalAlignment="Center"/>
</Grid></DataTemplate></ListBox.ItemTemplate></ListBox>
<StackPanel Grid.Column="1" Margin="16,0,0,0" MinWidth="150">
<Button Content="上移" Command="{Binding DataContext.MoveUpCommand, RelativeSource={RelativeSource AncestorType=Window}}" Margin="0,0,0,10"/>
<Button Content="下移" Command="{Binding DataContext.MoveDownCommand, RelativeSource={RelativeSource AncestorType=Window}}" Margin="0,0,0,10"/>
</StackPanel></Grid>
<StackPanel Grid.Row="3" Margin="0,12,0,0">
<TextBlock Text="{Binding SelectedPlan.Validation}" Foreground="#F2CC85" Margin="0,0,0,10" AutomationProperties.LiveSetting="Polite"/>
<WrapPanel IsEnabled="{Binding IsIdle}"><Button Content="保存任务选择" Command="{Binding SaveTasksCommand}" Margin="0,0,10,0"/><Button Content="放弃修改" Command="{Binding ReloadTasksCommand}"/></WrapPanel>
</StackPanel>
<Border Grid.Row="4" Style="{StaticResource Card}" Margin="0,12,0,0" DataContext="{Binding Configuration}"><StackPanel>
<TextBlock Text="上游配置 · 当前值与同步" FontSize="17" FontWeight="SemiBold"/>
<TextBlock Text="星铁仅开放已核对的布尔参数；体力计划与每日任务明细由原软件管理。" Foreground="{StaticResource Muted}" Margin="0,5,0,8"/>
<WrapPanel><Button Content="读取上游配置" Command="{Binding ReadCommand}" Margin="0,0,8,0"/><Button Content="保存参数" Command="{Binding SaveCommand}" Margin="0,0,8,0"/><Button Content="复制上游设置文件路径" Command="{Binding OpenSettingsCommand}"/></WrapPanel>
<TextBlock Text="{Binding Status}" Foreground="#F2CC85" Margin="0,8,0,8" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite"/>
<ScrollViewer MaxHeight="190" VerticalScrollBarVisibility="Auto"><ItemsControl ItemsSource="{Binding Parameters}"><ItemsControl.ItemTemplate><DataTemplate>
<Grid Margin="0,0,0,8"><Grid.ColumnDefinitions><ColumnDefinition Width="180"/><ColumnDefinition Width="*"/><ColumnDefinition Width="80"/></Grid.ColumnDefinitions>
<StackPanel><TextBlock Text="{Binding Title}" FontWeight="SemiBold"/><TextBlock Text="{Binding Path}" Foreground="{StaticResource Muted}" FontSize="11"/></StackPanel>
<StackPanel Grid.Column="1"><TextBox Text="{Binding Current, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding Editable}" AutomationProperties.Name="{Binding Title}"/><TextBlock Text="{Binding Description}" Foreground="{StaticResource Muted}" TextWrapping="Wrap"/></StackPanel>
<TextBlock Grid.Column="2" Text="{Binding State}" Foreground="#F2CC85" Margin="8,0,0,0"/></Grid>
</DataTemplate></ItemsControl.ItemTemplate></ItemsControl></ScrollViewer>
</StackPanel></Border></Grid></TabItem>

<TabItem Header="调度与监控"><Grid DataContext="{Binding Queue}">
<Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
<Border Style="{StaticResource Notice}"><StackPanel>
<TextBlock Text="模拟模式：这里的所有结果都是演示，不代表任何游戏的真实日常。" FontWeight="SemiBold" Foreground="#F2CC85"/>
<TextBlock Text="不会启动游戏或任何程序，不读写游戏文件，也不操作键盘鼠标。用于检验 VIvian 的串行调度、停止、清理核对与结果判定逻辑。" Foreground="#E8D9BC" Margin="0,6,0,0"/>
<TextBlock Text="本页的队列只运行模拟引擎。星铁单次测试仅能从“星铁实测”页经本人确认后启动；结果或清理无法确认时会阻断后续运行。" Foreground="#E8D9BC" Margin="0,6,0,0"/>
</StackPanel></Border>
<Grid Grid.Row="1" Margin="0,0,0,16"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
<ItemsControl ItemsSource="{Binding Games}" IsEnabled="{Binding IsIdle}"><ItemsControl.ItemTemplate><DataTemplate>
<Border Background="{StaticResource Surface}" CornerRadius="10" Padding="14,10" Margin="0,0,0,8"><Grid>
<Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
<CheckBox IsChecked="{Binding Include}" VerticalAlignment="Center" AutomationProperties.Name="{Binding Name}"/>
<TextBlock Grid.Column="1" Text="{Binding Name}" FontSize="16" VerticalAlignment="Center" Margin="10,0,12,0"/>
<ComboBox Grid.Column="2" MinWidth="200" ItemsSource="{Binding Source={x:Static local:DemoGameOption.Scenarios}}" DisplayMemberPath="Label" SelectedItem="{Binding Scenario}" AutomationProperties.Name="模拟情形"/>
</Grid></Border></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
<StackPanel Grid.Column="1" Margin="16,0,0,0" MinWidth="180">
<Button Content="开始模拟队列" Command="{Binding StartCommand}" IsEnabled="{Binding IsIdle}" Margin="0,0,0,10"/>
<Button Content="紧急停止" Command="{Binding StopCommand}" IsEnabled="{Binding IsRunning}" Background="#F08A80" Margin="0,0,0,10" AutomationProperties.HelpText="立即停止，不倒计时"/>
<TextBlock Text="{Binding Current}" Foreground="{StaticResource Muted}" AutomationProperties.LiveSetting="Polite"/>
</StackPanel></Grid>
<Grid Grid.Row="2"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
<DockPanel Margin="0,0,8,0"><TextBlock DockPanel.Dock="Top" Text="运行日志" FontSize="16" Margin="0,0,0,8"/>
<TextBlock DockPanel.Dock="Bottom" Text="{Binding Status}" Margin="0,8,0,0" AutomationProperties.LiveSetting="Polite"/>
<ListBox ItemsSource="{Binding LogLines}" Background="#101A2A" Foreground="#EEF3FB" BorderThickness="0" FontFamily="Consolas, Microsoft YaHei UI" VirtualizingPanel.IsVirtualizing="True" ScrollViewer.HorizontalScrollBarVisibility="Disabled"><ListBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding}" TextWrapping="Wrap" Foreground="#EEF3FB"/></DataTemplate></ListBox.ItemTemplate></ListBox></DockPanel>
<DockPanel Grid.Column="1" Margin="8,0,0,0"><TextBlock DockPanel.Dock="Top" Text="执行历史（清理状态与结果分开记录）" FontSize="16" Margin="0,0,0,8"/>
<Border DockPanel.Dock="Top" Background="#4A1F22" CornerRadius="10" Padding="12" Margin="0,0,0,8">
<Border.Style><Style TargetType="Border"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding HasUnresolved}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></Border.Style>
<StackPanel><TextBlock Text="有运行无法确认已清理。在你确认之前，新的队列不会启动。" Foreground="#FFD3CF"/>
<TextBlock Text="请先确认相关引擎和游戏都已关闭。你的确认会单独记录，不会改写原判定。" Foreground="#E8C2BE" Margin="0,4,0,8"/>
<Button Content="我已确认，全部已关闭" Command="{Binding AcknowledgeCommand}" IsEnabled="{Binding IsIdle}" HorizontalAlignment="Left"/></StackPanel></Border>
<ListView ItemsSource="{Binding Runs}" HorizontalContentAlignment="Stretch"><ListView.ItemTemplate><DataTemplate><StackPanel Margin="6">
<TextBlock Text="{Binding When}" Foreground="#93B3FF"/><TextBlock Text="{Binding RunId, StringFormat=RunId {0:D}}" Foreground="#93B3FF" Margin="0,4,0,0"/><TextBlock Text="{Binding Summary}" Margin="0,4,0,0" TextWrapping="Wrap"/>
</StackPanel></DataTemplate></ListView.ItemTemplate></ListView></DockPanel>
</Grid></Grid></TabItem>

<TabItem Header="设置与诊断"><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel IsEnabled="{Binding IsIdle}">
<TextBlock Text="设置与诊断" FontSize="24" FontWeight="SemiBold"/>
<TextBlock Text="{Binding VersionText}" Foreground="#93B3FF" Margin="0,10,0,4"/>
<TextBlock Text="{Binding DataDirectoryText}" Foreground="{StaticResource Muted}" Margin="0,0,0,16"/>
<Border Style="{StaticResource Card}"><StackPanel>
<TextBlock Text="应用偏好" FontSize="18" Margin="0,0,0,10"/>
<DockPanel Margin="0,0,0,10"><TextBlock Text="日志保留天数（3–90）：" VerticalAlignment="Center" Margin="0,0,8,0"/><TextBox Text="{Binding LogRetentionDays, UpdateSourceTrigger=PropertyChanged}" Width="80" HorizontalAlignment="Left" AutomationProperties.Name="日志保留天数"/></DockPanel>
<DockPanel Margin="0,0,0,10"><CheckBox IsChecked="{Binding IncludeRunHistory}" VerticalAlignment="Center" AutomationProperties.Name="诊断包包含运行记录"/><TextBlock Text="诊断包中包含运行记录（只有状态与原因代码）" Margin="8,0,0,0" VerticalAlignment="Center"/></DockPanel>
<WrapPanel><Button Content="保存设置" Command="{Binding SavePreferencesCommand}"/></WrapPanel>
</StackPanel></Border>
<Border Style="{StaticResource Card}"><StackPanel>
<TextBlock Text="诊断" FontSize="18" Margin="0,0,0,6"/>
<TextBlock Text="导出一个本地 ZIP，包含版本与系统信息、引擎只读检查结果、运行记录与最近日志。已去除用户目录、用户名、计算机名、邮箱以及口令/令牌样式的内容；不包含数据库、任何上游配置或账号信息；不会自动上传。" Foreground="{StaticResource Muted}" Margin="0,0,0,10"/>
<WrapPanel><Button Content="导出诊断包" Command="{Binding ExportDiagnosticsCommand}" Margin="0,0,10,8"/><Button Content="复制导出文件夹路径" Click="CopyExportsPath" Margin="0,0,10,8"/><Button Content="复制日志文件夹路径" Click="CopyLogsPath" Margin="0,0,10,8"/></WrapPanel>
<TextBlock Text="{Binding ExportStatus}" Foreground="{StaticResource Muted}" AutomationProperties.LiveSetting="Polite"/>
</StackPanel></Border>
<Border Style="{StaticResource Card}"><StackPanel>
<TextBlock Text="安装与兼容性说明" FontSize="18" Margin="0,0,0,6"/>
<TextBlock Text="· VIvian 以普通用户权限运行，不需要管理员权限，也不会静默提权。" Foreground="{StaticResource Muted}"/>
<TextBlock Text="· 支持基准：BetterGI v0.66.0、March7thAssistant v2026.10.31、OneDragon v2.6.0（WithRuntime-Full）。其他版本显示“不支持（版本）”。" Foreground="{StaticResource Muted}" Margin="0,4,0,0"/>
<TextBlock Text="· 只从各项目的官方 GitHub Release 下载引擎；星铁可在“引擎管理”中核对官方发行包。" Foreground="{StaticResource Muted}" Margin="0,4,0,0"/>
<TextBlock Text="· OneDragon 官方要求安装路径只含英文字母、数字、下划线和连字符，且没有空格。" Foreground="{StaticResource Muted}" Margin="0,4,0,0"/>
<TextBlock Text="· 请不要把引擎放在链接（符号链接、目录联接）后面；VIvian 会拒绝检查这样的目录。" Foreground="{StaticResource Muted}" Margin="0,4,0,0"/>
</StackPanel></Border>
</StackPanel></ScrollViewer></TabItem>

<TabItem Header="自检记录"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
<StackPanel Margin="0,0,0,16"><TextBlock Text="本地基础自检记录" FontSize="24"/><TextBlock Text="保留最近记录；这里不是游戏任务历史。时间显示为 UTC。" Foreground="{StaticResource Muted}" Margin="0,8,0,12"/><Button Content="刷新记录与配置" Command="{Binding ReloadCommand}" IsEnabled="{Binding IsIdle}" HorizontalAlignment="Left"/></StackPanel>
<ListView Grid.Row="1" ItemsSource="{Binding History}" HorizontalContentAlignment="Stretch"><ListView.ItemTemplate><DataTemplate><StackPanel Margin="10"><TextBlock Text="{Binding StartedAt, StringFormat={}{0:yyyy-MM-dd HH:mm:ss} UTC}" Foreground="#93B3FF"/><TextBlock Text="{Binding Summary}" Margin="0,6,0,0" TextWrapping="Wrap"/></StackPanel></DataTemplate></ListView.ItemTemplate></ListView>
</Grid></TabItem>

<TabItem Header="关于"><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="4">
<TextBlock Text="一个控制中心，三款独立引擎。" FontSize="24" FontWeight="SemiBold"/>
<TextBlock Text="{Binding VersionText}" Margin="0,14,0,24" Foreground="#93B3FF"/>
<TextBlock Text="已提供并经自动测试：本地配置与任务计划、SQLite 持久化与迁移、日志轮转与保留、诊断包导出（已脱敏）、单实例保护，以及模拟模式下的串行调度、紧急停止、清理核对、运行记录与崩溃后对账；三款引擎的只读检查与星铁官方发行包核对。" Margin="0,0,0,16"/>
<TextBlock Text="已实现但待 Windows 桌面验证：隔离副本中的引擎诊断命令、真实引擎的进程归属与 UAC 边界、完成证据的判定规则。" Margin="0,0,0,16"/>
<TextBlock Text="未开放：真实游戏自动日常、引擎安装更新与回滚、托盘。" Margin="0,0,0,16"/>
<TextBlock Text="三款引擎由各自开源项目维护。本程序无官方游戏关联，不收集游戏密码，不自动上传诊断信息。" Margin="0,0,0,16"/>
<TextBlock Text="游戏自动化存在账号处罚风险。后续接入不会承诺零风险，也不会绕过反作弊。" Foreground="#E5BF76"/>
</StackPanel></ScrollViewer></TabItem>
</TabControl>
<Border Grid.Row="2" Background="#18253A" CornerRadius="10" Padding="14" Margin="0,18,0,0"><TextBlock Text="{Binding Status}" AutomationProperties.LiveSetting="Polite"/></Border>
</Grid></Window>
